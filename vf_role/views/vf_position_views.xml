<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Position List View -->
        <record id="vf_position_view_tree" model="ir.ui.view">
            <field name="name">vf.position.tree</field>
            <field name="model">vf.position</field>
            <field name="arch" type="xml">
                <tree string="Positions">
                    <field name="display_name"/>
                    <field name="role_id"/>
                    <field name="section_id"/>
                    <field name="group_id"/>
                    <field name="current_holder_count"/>
                    <field name="max_holders"/>
                    <field name="is_active"/>
                </tree>
            </field>
        </record>
        
        <!-- Position Form View -->
        <record id="vf_position_view_form" model="ir.ui.view">
            <field name="name">vf.position.form</field>
            <field name="model">vf.position</field>
            <field name="arch" type="xml">
                <form string="Position">
                    <header>
                        <button name="action_assign_mandate" type="object" string="Assign Mandate" 
                                class="btn-primary"/>
                        <button name="action_view_mandates" type="object" string="View Mandates"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_mandates" type="object" 
                                    class="oe_stat_button" icon="fa-user">
                                <field name="current_holder_count" widget="statinfo" 
                                       string="Current Holders"/>
                            </button>
                        </div>
                        
                        <group>
                            <group name="position_info">
                                <field name="name"/>
                                <field name="role_id"/>
                                <field name="max_holders"/>
                            </group>
                            <group name="scope">
                                <field name="section_id"/>
                                <field name="group_id" 
                                       attrs="{'invisible': [('section_id', '=', False)]}"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Mandates">
                                <field name="mandate_ids">
                                    <tree>
                                        <field name="person_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="status"/>
                                        <field name="appointed_by"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Position Search View -->
        <record id="vf_position_view_search" model="ir.ui.view">
            <field name="name">vf.position.search</field>
            <field name="model">vf.position</field>
            <field name="arch" type="xml">
                <search string="Search Positions">
                    <field name="name"/>
                    <field name="role_id"/>
                    <field name="section_id"/>
                    <field name="group_id"/>
                    <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('is_active', '=', False)]"/>
                    <filter string="Available" name="available" 
                            domain="[('current_holder_count', '&lt;', 'max_holders')]"/>
                    <filter string="Full" name="full" 
                            domain="[('current_holder_count', '>=', 'max_holders')]"/>
                    <separator/>
                    <filter string="Organization Level" name="org_level" 
                            domain="[('section_id', '=', False), ('group_id', '=', False)]"/>
                    <filter string="Section Level" name="section_level" 
                            domain="[('section_id', '!=', False), ('group_id', '=', False)]"/>
                    <filter string="Group Level" name="group_level" 
                            domain="[('group_id', '!=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Role" name="group_role" context="{'group_by': 'role_id'}"/>
                        <filter string="Section" name="group_section" context="{'group_by': 'section_id'}"/>
                        <filter string="Group" name="group_group" context="{'group_by': 'group_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Position Action -->
        <record id="vf_position_action" model="ir.actions.act_window">
            <field name="name">Positions</field>
            <field name="res_model">vf.position</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first position!
                </p>
                <p>
                    Positions are specific instances of roles within sections or groups.
                    They can be assigned to members through mandates.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_position_menu" name="Positions" 
                  parent="vf_base.vf_menu_organization" 
                  sequence="40"
                  action="vf_position_action"/>
    </data>
</odoo>
