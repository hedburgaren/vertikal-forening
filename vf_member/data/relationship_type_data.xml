<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Guardian Relationship Types -->
        <record id="relationship_type_primary" model="vf.relationship.type">
            <field name="name">Primary Guardian</field>
            <field name="code">primary</field>
            <field name="description">Main guardian with primary responsibility</field>
            <field name="sequence">10</field>
            <field name="is_guardian_type">True</field>
        </record>
        
        <record id="relationship_type_secondary" model="vf.relationship.type">
            <field name="name">Secondary Guardian</field>
            <field name="code">secondary</field>
            <field name="description">Additional guardian with shared responsibility</field>
            <field name="sequence">20</field>
            <field name="is_guardian_type">True</field>
        </record>
        
        <record id="relationship_type_emergency" model="vf.relationship.type">
            <field name="name">Emergency Contact</field>
            <field name="code">emergency</field>
            <field name="description">Emergency contact only</field>
            <field name="sequence">30</field>
            <field name="is_guardian_type">True</field>
        </record>
        
        <!-- Family Relationship Types -->
        <record id="relationship_type_sibling" model="vf.relationship.type">
            <field name="name">Sibling</field>
            <field name="code">sibling</field>
            <field name="description">Brother or sister</field>
            <field name="sequence">10</field>
            <field name="is_family_type">True</field>
        </record>
        
        <record id="relationship_type_parent_adult" model="vf.relationship.type">
            <field name="name">Parent (Adult Member)</field>
            <field name="code">parent_adult</field>
            <field name="description">Parent who is also an adult member</field>
            <field name="sequence">20</field>
            <field name="is_family_type">True</field>
        </record>
        
        <record id="relationship_type_spouse" model="vf.relationship.type">
            <field name="name">Spouse/Partner</field>
            <field name="code">spouse</field>
            <field name="description">Married or partnered couple</field>
            <field name="sequence">30</field>
            <field name="is_family_type">True</field>
        </record>
        
        <record id="relationship_type_other" model="vf.relationship.type">
            <field name="name">Other Family</field>
            <field name="code">other</field>
            <field name="description">Other family relationship</field>
            <field name="sequence">90</field>
            <field name="is_family_type">True</field>
        </record>
    </data>
</odoo>
