<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Family Relationship List View -->
        <record id="vf_family_relationship_view_tree" model="ir.ui.view">
            <field name="name">vf.family.relationship.tree</field>
            <field name="model">vf.family.relationship</field>
            <field name="arch" type="xml">
                <tree string="Family Relationships">
                    <field name="member_id"/>
                    <field name="related_member_id"/>
                    <field name="relationship_type_id"/>
                    <field name="household_id"/>
                </tree>
            </field>
        </record>
        
        <!-- Family Relationship Form View -->
        <record id="vf_family_relationship_view_form" model="ir.ui.view">
            <field name="name">vf.family.relationship.form</field>
            <field name="model">vf.family.relationship</field>
            <field name="arch" type="xml">
                <form string="Family Relationship">
                    <header>
                        <button name="action_create_reverse" type="object" string="Create Reverse Relationship"/>
                    </header>
                    <sheet>
                        <group>
                            <group name="relationship_info">
                                <field name="member_id"/>
                                <field name="related_member_id"/>
                                <field name="relationship_type_id"/>
                            </group>
                            <group name="household">
                                <field name="household_id"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Notes" groups="vf_base.vf_admin">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Family Relationship Action -->
        <record id="vf_family_relationship_action" model="ir.actions.act_window">
            <field name="name">Family Relationships</field>
            <field name="res_model">vf.family.relationship</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
