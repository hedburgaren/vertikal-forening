<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Partner Form View Extension -->
        <record id="view_res_partner_form_inherit_vf_member" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.vf.member</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_id']" position="after">
                    <group name="vf_member_info" string="Association Membership" 
                           attrs="{'invisible': [('is_company', '=', True)]}">
                        <field name="is_member" readonly="1"/>
                        <field name="member_id" readonly="1" attrs="{'invisible': [('is_member', '=', False)]}"/>
                        <button name="action_create_member" type="object" string="Create Member" 
                                attrs="{'invisible': [('is_member', '=', True)]}" class="btn-link"/>
                        <button name="action_view_member" type="object" string="View Member" 
                                attrs="{'invisible': [('is_member', '=', False)]}" class="btn-link"/>
                    </group>
                </xpath>
                
                <xpath expr="//notebook" position="inside">
                    <page string="Association" attrs="{'invisible': [('is_company', '=', True)]}">
                        <group>
                            <group string="Guardian Responsibilities">
                                <field name="has_guardian_responsibilities" readonly="1"/>
                                <button name="action_view_guardian_relationships" type="object" 
                                        string="View Guardian Relationships" 
                                        attrs="{'invisible': [('has_guardian_responsibilities', '=', False)]}"/>
                            </group>
                            <group string="Household">
                                <field name="household_member_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        
        <!-- Partner Kanban View Extension -->
        <record id="view_res_partner_kanban_inherit_vf_member" model="ir.ui.view">
            <field name="name">res.partner.kanban.inherit.vf.member</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.res_partner_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='display_name']" position="after">
                    <t t-if="record.is_member.raw_value">
                        <div class="oe_kanban_bottom_right">
                            <span class="badge badge-primary">Member</span>
                        </div>
                    </t>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
