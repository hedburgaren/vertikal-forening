<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Template Manager Group -->
        <record id="vf_template_manager" model="res.groups">
            <field name="name">Vertical Association - Template Manager</field>
            <field name="category_id" ref="vertical_association_sweden.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('vertical_association_sweden.group_vf_user'))]"/>
        </record>
        
        <!-- Template Administrator Group -->
        <record id="vf_template_admin" model="res.groups">
            <field name="name">Vertical Association - Template Administrator</field>
            <field name="category_id" ref="vertical_association_sweden.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('vf_template_manager'))]"/>
        </record>
        
        <!-- Access Rights for Template Categories -->
        <record id="rule_template_category_manager" model="ir.rule">
            <field name="name">Template Category: Manager</field>
            <field name="model_id" ref="model_vf_template_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vf_template_manager'))]"/>
        </record>
        
        <!-- Access Rights for Document Templates -->
        <record id="rule_document_template_manager" model="ir.rule">
            <field name="name">Document Template: Manager</field>
            <field name="model_id" ref="model_vf_document_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vf_template_manager'))]"/>
        </record>
        
        <!-- Access Rights for Email Templates -->
        <record id="rule_email_template_manager" model="ir.rule">
            <field name="name">Email Template: Manager</field>
            <field name="model_id" ref="model_vf_email_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vf_template_manager'))]"/>
        </record>
        
        <!-- Access Rights for Communication Layouts -->
        <record id="rule_communication_layout_manager" model="ir.rule">
            <field name="name">Communication Layout: Manager</field>
            <field name="model_id" ref="model_vf_communication_layout"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vf_template_manager'))]"/>
        </record>
        
        <!-- Access Rights for Template Variables -->
        <record id="rule_template_variable_manager" model="ir.rule">
            <field name="name">Template Variable: Manager</field>
            <field name="model_id" ref="model_vf_template_variable"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vf_template_manager'))]"/>
        </record>
    </data>
</odoo>
