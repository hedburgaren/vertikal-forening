<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rules -->
        <!-- Activities: Users can see activities they have access to -->
        <record id="rule_vf_activity_user" model="ir.rule">
            <field name="name">VF Activity: Accessible Activities</field>
            <field name="model_id" ref="model_vf_activity"/>
            <field name="domain_force">['|', ('visibility', '=', 'public'), ('id', 'in', user.partner_id.accessible_activity_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_user'))]"/>
        </record>
        
        <!-- Activities: Leaders can see activities in their scope -->
        <record id="rule_vf_activity_leader" model="ir.rule">
            <field name="name">VF Activity: Scope Activities</field>
            <field name="model_id" ref="model_vf_activity"/>
            <field name="domain_force">['|', ('visibility', 'in', ['public', 'members']), ('section_id.manager_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_leader'))]"/>
        </record>
        
        <!-- Activities: Admins can see all -->
        <record id="rule_vf_activity_admin" model="ir.rule">
            <field name="name">VF Activity: All</field>
            <field name="model_id" ref="model_vf_activity"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_admin'))]"/>
        </record>
        
        <!-- Activity Schedules: Inherit from activity rules -->
        <record id="rule_vf_activity_schedule_user" model="ir.rule">
            <field name="name">VF Activity Schedule: Accessible</field>
            <field name="model_id" ref="model_vf_activity_schedule"/>
            <field name="domain_force">[('activity_id.id', 'in', user.partner_id.accessible_activity_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_user'))]"/>
        </record>
        
        <record id="rule_vf_activity_schedule_admin" model="ir.rule">
            <field name="name">VF Activity Schedule: All</field>
            <field name="model_id" ref="model_vf_activity_schedule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_admin'))]"/>
        </record>
        
        <!-- Resources: Everyone can read, only admins can write -->
        <record id="rule_vf_resource_admin" model="ir.rule">
            <field name="name">VF Resource: Admin Only</field>
            <field name="model_id" ref="model_vf_resource"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Activity Types: Everyone can read, only admins can write -->
        <record id="rule_vf_activity_type_admin" model="ir.rule">
            <field name="name">VF Activity Type: Admin Only</field>
            <field name="model_id" ref="model_vf_activity_type"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
