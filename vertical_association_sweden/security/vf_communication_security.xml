<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rules -->
        <!-- Messages: Users can see their own sent and received messages -->
        <record id="rule_vf_message_own" model="ir.rule">
            <field name="name">VF Message: Own Messages</field>
            <field name="model_id" ref="model_vf_message"/>
            <field name="domain_force">['|', ('sender_id', '=', user.partner_id.id), ('recipient_ids', 'in', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_user'))]"/>
        </record>
        
        <!-- Messages: Leaders can see messages in their scope -->
        <record id="rule_vf_message_leader" model="ir.rule">
            <field name="name">VF Message: Scope Messages</field>
            <field name="model_id" ref="model_vf_message"/>
            <field name="domain_force">['|', ('recipient_group_ids.leader_id', '=', user.partner_id.id), ('recipient_section_ids.manager_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_leader'))]"/>
        </record>
        
        <!-- Messages: Admins can see all -->
        <record id="rule_vf_message_admin" model="ir.rule">
            <field name="name">VF Message: All</field>
            <field name="model_id" ref="model_vf_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_admin'))]"/>
        </record>
        
        <!-- Mailboxes: Users can see mailboxes they can access -->
        <record id="rule_vf_mailbox_user" model="ir.rule">
            <field name="name">VF Mailbox: Accessible</field>
            <field name="model_id" ref="model_vf_mailbox"/>
            <field name="domain_force">[('id', 'in', user.partner_id.mailbox_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_user'))]"/>
        </record>
        
        <!-- Mailboxes: Leaders can see mailboxes in their scope -->
        <record id="rule_vf_mailbox_leader" model="ir.rule">
            <field name="name">VF Mailbox: Scope Mailboxes</field>
            <field name="model_id" ref="model_vf_mailbox"/>
            <field name="domain_force">['|', ('group_id.leader_id', '=', user.partner_id.id), ('section_id.manager_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_leader'))]"/>
        </record>
        
        <!-- Mailboxes: Admins can see all -->
        <record id="rule_vf_mailbox_admin" model="ir.rule">
            <field name="name">VF Mailbox: All</field>
            <field name="model_id" ref="model_vf_mailbox"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_admin'))]"/>
        </record>
        
        <!-- Contact Forms: Users can see their own contact forms -->
        <record id="rule_vf_contact_form_own" model="ir.rule">
            <field name="name">VF Contact Form: Own</field>
            <field name="model_id" ref="model_vf_contact_form"/>
            <field name="domain_force">[('sender_email', '=', user.partner_id.email)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_user'))]"/>
        </record>
        
        <!-- Contact Forms: Leaders can see forms sent to their mailboxes -->
        <record id="rule_vf_contact_form_leader" model="ir.rule">
            <field name="name">VF Contact Form: Mailbox Forms</field>
            <field name="model_id" ref="model_vf_contact_form"/>
            <field name="domain_force">[('mailbox_id', 'in', user.partner_id.mailbox_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_leader'))]"/>
        </record>
        
        <!-- Contact Forms: Admins can see all -->
        <record id="rule_vf_contact_form_admin" model="ir.rule">
            <field name="name">VF Contact Form: All</field>
            <field name="model_id" ref="model_vf_contact_form"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vertical_association_sweden.group_vf_admin'))]"/>
        </record>
    </data>
</odoo>
