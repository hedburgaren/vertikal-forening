<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Security Groups -->
        <record id="group_economy_user" model="res.groups">
            <field name="name">Economy User</field>
            <field name="category_id" ref="vertical_association_sweden.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="group_economy_manager" model="res.groups">
            <field name="name">Economy Manager</field>
            <field name="category_id" ref="vertical_association_sweden.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('group_economy_user'))]"/>
        </record>
        
        <record id="group_economy_admin" model="res.groups">
            <field name="name">Economy Admin</field>
            <field name="category_id" ref="vertical_association_sweden.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('group_economy_manager'))]"/>
        </record>
        
        <!-- Record Rules -->
        <record id="rule_economy_report_user" model="ir.rule">
            <field name="name">Economy Report: User Read</field>
            <field name="model_id" ref="model_vf_economy_report"/>
            <field name="domain_force">['|', ('generated_by', '=', user.id), ('state', 'in', ['generated', 'exported'])]</field>
            <field name="groups" eval="[(4, ref('group_economy_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="rule_payment_view_user" model="ir.rule">
            <field name="name">Payment View: User Read</field>
            <field name="model_id" ref="model_vf_payment_view"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_economy_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="rule_export_access_user" model="ir.rule">
            <field name="name">Export Access: User Read Own</field>
            <field name="model_id" ref="model_vf_export_access"/>
            <field name="domain_force">['|', ('allowed_user_ids', 'in', [user.id]), ('allowed_group_ids', 'in', [g.id for g in user.groups_id])]</field>
            <field name="groups" eval="[(4, ref('group_economy_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
