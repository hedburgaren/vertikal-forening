<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Document Categories -->
        <record id="category_meeting_minutes" model="vf.document.category">
            <field name="name">Meeting Minutes</field>
            <field name="code">MEETING_MINUTES</field>
            <field name="description">Minutes from board meetings, annual meetings, and committee meetings</field>
            <field name="sequence">10</field>
            <field name="default_visibility">members</field>
            <field name="allow_templates">True</field>
        </record>
        
        <record id="category_policies" model="vf.document.category">
            <field name="name">Policies & Procedures</field>
            <field name="code">POLICIES</field>
            <field name="description">Association policies, bylaws, and operational procedures</field>
            <field name="sequence">20</field>
            <field name="default_visibility">members</field>
            <field name="allow_templates">True</field>
        </record>
        
        <record id="category_forms" model="vf.document.category">
            <field name="name">Forms & Applications</field>
            <field name="code">FORMS</field>
            <field name="description">Membership forms, applications, and various association forms</field>
            <field name="sequence">30</field>
            <field name="default_visibility">public</field>
            <field name="allow_templates">True</field>
        </record>
        
        <record id="category_financial" model="vf.document.category">
            <field name="name">Financial Reports</field>
            <field name="code">FINANCIAL</field>
            <field name="description">Annual reports, budgets, and financial statements</field>
            <field name="sequence">40</field>
            <field name="default_visibility">leadership</field>
            <field name="allow_templates">True</field>
        </record>
        
        <record id="category_training" model="vf.document.category">
            <field name="name">Training Materials</field>
            <field name="code">TRAINING</field>
            <field name="description">Training guides, manuals, and educational materials</field>
            <field name="sequence">50</field>
            <field name="default_visibility">members</field>
            <field name="allow_templates">True</field>
        </record>
        
        <record id="category_safety" model="vf.document.category">
            <field name="name">Safety & Guidelines</field>
            <field name="code">SAFETY</field>
            <field name="description">Safety guidelines, risk assessments, and emergency procedures</field>
            <field name="sequence">60</field>
            <field name="default_visibility">members</field>
            <field name="allow_templates">False</field>
        </record>
        
        <record id="category_events" model="vf.document.category">
            <field name="name">Event Documents</field>
            <field name="code">EVENTS</field>
            <field name="description">Event programs, schedules, and related documents</field>
            <field name="sequence">70</field>
            <field name="default_visibility">members</field>
            <field name="allow_templates">True</field>
        </record>
        
        <record id="category_legal" model="vf.document.category">
            <field name="name">Legal Documents</field>
            <field name="code">LEGAL</field>
            <field name="description">Legal agreements, contracts, and compliance documents</field>
            <field name="sequence">80</field>
            <field name="default_visibility">leadership</field>
            <field name="allow_templates">False</field>
        </record>
        
        <record id="category_other" model="vf.document.category">
            <field name="name">Other</field>
            <field name="code">OTHER</field>
            <field name="description">Other documents that don't fit in specific categories</field>
            <field name="sequence">90</field>
            <field name="default_visibility">custom</field>
            <field name="allow_templates">True</field>
        </record>
    </data>
</odoo>
