<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Portal Dashboard Template -->
        <template id="portal_my_home" inherit_id="portal.portal_my_home">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-if="is_member">
                    <div class="o_portal_block">
                        <h3 class="o_portal_block_title">Association</h3>
                        <ul class="o_portal_block_list">
                            <li>
                                <a href="/my/activities">My Activities</a>
                            </li>
                            <li>
                                <a href="/my/fees">My Fees & Payments</a>
                            </li>
                            <li>
                                <a href="/my/documents">Documents</a>
                            </li>
                        </ul>
                    </div>
                </t>
            </xpath>
        </template>
        
        <!-- Member Dashboard -->
        <template id="portal_member_dashboard" name="Member Dashboard">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar">False</t>
                
                <div class="o_portal_my_home">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8">
                                <h3>Member Dashboard</h3>
                                <p>Welcome back, <span t-esc="member.name"/>!</p>
                                
                                <div class="row mt-4">
                                    <div class="col-md-4">
                                        <div class="card">
                                            <div class="card-body text-center">
                                                <h4 t-esc="member.group_count">0</h4>
                                                <p class="text-muted">Groups</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card">
                                            <div class="card-body text-center">
                                                <h4 t-esc="member.activity_count">0</h4>
                                                <p class="text-muted">Activities</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card">
                                            <div class="card-body text-center">
                                                <h4 t-esc="member.outstanding_amount">0</h4>
                                                <p class="text-muted">Outstanding</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-lg-4">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Quick Actions</h5>
                                    </div>
                                    <div class="card-body">
                                        <a href="/my/activities/register" class="btn btn-primary btn-block mb-2">Register for Activity</a>
                                        <a href="/my/fees" class="btn btn-secondary btn-block mb-2">View Fees</a>
                                        <a href="/my/documents" class="btn btn-secondary btn-block">View Documents</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
