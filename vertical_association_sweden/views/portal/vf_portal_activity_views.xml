<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Portal Activity Tree View -->
        <record id="vf_portal_activity_view_tree" model="ir.ui.view">
            <field name="name">vf.portal.activity.tree</field>
            <field name="model">vf.portal.activity</field>
            <field name="arch" type="xml">
                <tree string="Portal Activity Registrations">
                    <field name="schedule_id"/>
                    <field name="member_id"/>
                    <field name="date_registered"/>
                    <field name="state"/>
                    <field name="confirmation_sent"/>
                </tree>
            </field>
        </record>
        
        <!-- Portal Activity Form View -->
        <record id="vf_portal_activity_view_form" model="ir.ui.view">
            <field name="name">vf.portal.activity.form</field>
            <field name="model">vf.portal.activity</field>
            <field name="arch" type="xml">
                <form string="Portal Activity Registration">
                    <header>
                        <button name="action_cancel_via_portal" type="object" string="Cancel Registration" 
                                attrs="{'invisible': [('state', 'in', ['cancelled', 'attended'])]}" class="btn-warning"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group name="registration_info">
                                <field name="schedule_id" required="1"/>
                                <field name="member_id" required="1"/>
                                <field name="date_registered" readonly="1"/>
                            </group>
                            <group name="confirmation_info">
                                <field name="confirmation_sent" readonly="1"/>
                                <field name="confirmation_date" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Notes">
                                <field name="notes"/>
                                <field name="portal_notes"/>
                            </page>
                            
                            <page string="Waiting List" attrs="{'invisible': [('waiting_list_position', '=', 0)]}">
                                <group>
                                    <field name="waiting_list_position"/>
                                    <field name="waiting_list_date"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Portal Activity Search View -->
        <record id="vf_portal_activity_view_search" model="ir.ui.view">
            <field name="name">vf.portal.activity.search</field>
            <field name="model">vf.portal.activity</field>
            <field name="arch" type="xml">
                <search string="Search Portal Activity Registrations">
                    <field name="schedule_id"/>
                    <field name="member_id"/>
                    <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <filter string="Attended" name="attended" domain="[('state', '=', 'attended')]"/>
                    <filter string="Waiting List" name="waiting_list" domain="[('waiting_list_position', '>', 0)]"/>
                    <filter string="Confirmation Sent" name="confirmation_sent" domain="[('confirmation_sent', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Activity" name="group_activity" context="{'group_by': 'schedule_id'}"/>
                        <filter string="Member" name="group_member" context="{'group_by': 'member_id'}"/>
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Portal Activity Action -->
        <record id="vf_portal_activity_action" model="ir.actions.act_window">
            <field name="name">Portal Activity Registrations</field>
            <field name="res_model">vf.portal.activity</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No portal activity registrations yet.
                </p>
                <p>
                    Portal activity registrations are created when members
                    register for activities through the member portal.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_portal_activity_menu" name="Activity Registrations" parent="vf_portal_menu" 
                  sequence="20" action="vf_portal_activity_action"/>
    </data>
</odoo>
