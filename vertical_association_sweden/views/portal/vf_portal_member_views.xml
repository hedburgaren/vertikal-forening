<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Portal Member Tree View -->
        <record id="vf_portal_member_view_tree" model="ir.ui.view">
            <field name="name">vf.portal.member.tree</field>
            <field name="model">vf.portal.member</field>
            <field name="arch" type="xml">
                <tree string="Portal Members">
                    <field name="member_id"/>
                    <field name="user_id"/>
                    <field name="email_notifications"/>
                    <field name="last_login"/>
                    <field name="login_count"/>
                </tree>
            </field>
        </record>
        
        <!-- Portal Member Form View -->
        <record id="vf_portal_member_view_form" model="ir.ui.view">
            <field name="name">vf.portal.member.form</field>
            <field name="model">vf.portal.member</field>
            <field name="arch" type="xml">
                <form string="Portal Member Settings">
                    <sheet>
                        <group>
                            <group name="member_info">
                                <field name="member_id" required="1"/>
                                <field name="user_id" required="1"/>
                            </group>
                            <group name="login_info">
                                <field name="last_login" readonly="1"/>
                                <field name="login_count" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Permissions">
                                <group>
                                    <field name="allow_self_registration"/>
                                    <field name="allow_document_access"/>
                                    <field name="allow_payment_view"/>
                                </group>
                            </page>
                            
                            <page string="Notifications">
                                <group>
                                    <field name="email_notifications"/>
                                    <field name="sms_notifications"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Portal Member Action -->
        <record id="vf_portal_member_action" model="ir.actions.act_window">
            <field name="name">Portal Members</field>
            <field name="res_model">vf.portal.member</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first portal member!
                </p>
                <p>
                    Portal members control which members have access to the
                    member portal and their specific permissions.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_portal_menu" name="Portal" parent="vertical_association_sweden.vf_root_menu" 
                  sequence="70" action="vf_portal_member_action"/>
        <menuitem id="vf_portal_member_menu" name="Portal Members" parent="vf_portal_menu" 
                  sequence="10" action="vf_portal_member_action"/>
    </data>
</odoo>
