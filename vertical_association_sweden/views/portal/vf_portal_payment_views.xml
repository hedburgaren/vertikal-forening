<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Portal Payment Tree View -->
        <record id="vf_portal_payment_view_tree" model="ir.ui.view">
            <field name="name">vf.portal.payment.tree</field>
            <field name="model">vf.portal.payment</field>
            <field name="arch" type="xml">
                <tree string="Portal Payments">
                    <field name="fee_id"/>
                    <field name="payment_method"/>
                    <field name="amount"/>
                    <field name="payment_date"/>
                    <field name="payment_status"/>
                    <field name="paid_via_portal"/>
                </tree>
            </field>
        </record>
        
        <!-- Portal Payment Form View -->
        <record id="vf_portal_payment_view_form" model="ir.ui.view">
            <field name="name">vf.portal.payment.form</field>
            <field name="model">vf.portal.payment</field>
            <field name="arch" type="xml">
                <form string="Portal Payment">
                    <sheet>
                        <group>
                            <group name="payment_info">
                                <field name="fee_id" required="1"/>
                                <field name="payment_method" required="1"/>
                                <field name="amount" required="1"/>
                                <field name="payment_date"/>
                            </group>
                            <group name="status_info">
                                <field name="paid_via_portal"/>
                                <field name="payment_status" readonly="1"/>
                                <field name="transaction_id" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Refund" attrs="{'invisible': [('payment_status', '!=', 'completed')]}">
                                <group>
                                    <field name="refund_amount"/>
                                    <field name="refund_reason"/>
                                    <field name="refund_date"/>
                                </group>
                            </page>
                            
                            <page string="Payment Details">
                                <group>
                                    <field name="card_last_four" attrs="{'invisible': [('payment_method', '!=', 'card')]}"/>
                                    <field name="bank_reference" attrs="{'invisible': [('payment_method', '!=', 'bank_transfer')]}"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Portal Payment Search View -->
        <record id="vf_portal_payment_view_search" model="ir.ui.view">
            <field name="name">vf.portal.payment.search</field>
            <field name="model">vf.portal.payment</field>
            <field name="arch" type="xml">
                <search string="Search Portal Payments">
                    <field name="fee_id"/>
                    <field name="transaction_id"/>
                    <field name="payment_method"/>
                    <filter string="Pending" name="pending" domain="[('payment_status', '=', 'pending')]"/>
                    <filter string="Completed" name="completed" domain="[('payment_status', '=', 'completed')]"/>
                    <filter string="Failed" name="failed" domain="[('payment_status', '=', 'failed')]"/>
                    <filter string="Refunded" name="refunded" domain="[('payment_status', '=', 'refunded')]"/>
                    <filter string="Portal Payments" name="portal" domain="[('paid_via_portal', '=', True)]"/>
                    <filter string="Manual Payments" name="manual" domain="[('paid_via_portal', '=', False)]"/>
                    <filter string="This Month" name="this_month" 
                            domain="[('payment_date', '>=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Payment Method" name="group_method" context="{'group_by': 'payment_method'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'payment_status'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'payment_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Portal Payment Action -->
        <record id="vf_portal_payment_action" model="ir.actions.act_window">
            <field name="name">Portal Payments</field>
            <field name="res_model">vf.portal.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_completed': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No portal payments yet.
                </p>
                <p>
                    Portal payments are created when members pay fees
                    through the member portal.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_portal_payment_menu" name="Payments" parent="vf_portal_menu" 
                  sequence="40" action="vf_portal_payment_action"/>
    </data>
</odoo>
