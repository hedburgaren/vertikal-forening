<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Payment Reminder Wizard Form View -->
        <record id="vf_payment_reminder_wizard_view_form" model="ir.ui.view">
            <field name="name">vf.payment.reminder.wizard.form</field>
            <field name="model">vf.payment.reminder.wizard</field>
            <field name="arch" type="xml">
                <form string="Send Payment Reminders">
                    <group>
                        <field name="member_ids" widget="many2many_tags"/>
                        <field name="fee_ids" widget="many2many_tags"/>
                        <field name="template_id"/>
                        <field name="send_email"/>
                    </group>
                    <group string="Preview">
                        <field name="message_body" widget="text" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_send_reminders" type="object" string="Send Reminders" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- Payment Reminder Wizard Action -->
        <record id="vf_payment_reminder_wizard_action" model="ir.actions.act_window">
            <field name="name">Send Payment Reminders</field>
            <field name="res_model">vf.payment.reminder.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
