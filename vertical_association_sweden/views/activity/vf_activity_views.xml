<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Activity List View -->
        <record id="vf_activity_view_tree" model="ir.ui.view">
            <field name="name">vf.activity.tree</field>
            <field name="model">vf.activity</field>
            <field name="arch" type="xml">
                <tree string="Activities">
                    <field name="display_name"/>
                    <field name="activity_type_id"/>
                    <field name="start_date"/>
                    <field name="state"/>
                    <field name="visibility"/>
                    <field name="participant_count"/>
                    <field name="available_spots"/>
                </tree>
            </field>
        </record>
        
        <!-- Activity Form View -->
        <record id="vf_activity_view_form" model="ir.ui.view">
            <field name="name">vf.activity.form</field>
            <field name="model">vf.activity</field>
            <field name="arch" type="xml">
                <form string="Activity">
                    <header>
                        <button name="action_plan" type="object" string="Plan" 
                                attrs="{'invisible': [('state', '!=', 'draft')]}" class="btn-primary"/>
                        <button name="action_confirm" type="object" string="Confirm" 
                                attrs="{'invisible': [('state', 'not in', ['draft', 'planned'])]}"/>
                        <button name="action_start" type="object" string="Start" 
                                attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                        <button name="action_complete" type="object" string="Complete" 
                                attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                        <button name="action_cancel" type="object" string="Cancel" 
                                attrs="{'invisible': [('state', '=', 'cancelled')]}"/>
                        <button name="action_set_to_draft" type="object" string="Set to Draft" 
                                attrs="{'invisible': [('state', '=', 'draft')]}"/>
                        <button name="action_view_schedule" type="object" string="Schedule"/>
                        <button name="action_view_participants" type="object" string="Participants"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,planned,confirmed,in_progress,completed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_participants" type="object" 
                                    class="oe_stat_button" icon="fa-users">
                                <field name="participant_count" widget="statinfo" 
                                       string="Participants"/>
                            </button>
                            <button name="action_view_schedule" type="object" 
                                    class="oe_stat_button" icon="fa-calendar">
                                <field name="schedule_count" widget="statinfo" 
                                       string="Schedules"/>
                            </button>
                        </div>
                        
                        <group>
                            <group name="activity_info">
                                <field name="name"/>
                                <field name="activity_type_id"/>
                                <field name="visibility"/>
                            </group>
                            <group name="dates">
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="registration_deadline"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Description">
                                <field name="description" nolabel="1"/>
                            </page>
                            
                            <page string="Registration">
                                <group>
                                    <group string="Registration Settings">
                                        <field name="allow_registration"/>
                                        <field name="require_approval"/>
                                        <field name="max_participants"/>
                                        <field name="min_participants"/>
                                    </group>
                                    <group string="Registration Period">
                                        <field name="registration_start"/>
                                        <field name="registration_end"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Schedule">
                                <field name="schedule_ids">
                                    <tree>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="location"/>
                                        <field name="instructor_id"/>
                                    </tree>
                                </field>
                            </page>
                            
                            <page string="Participants">
                                <field name="registration_ids">
                                    <tree>
                                        <field name="member_id"/>
                                        <field name="registration_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Activity Kanban View -->
        <record id="vf_activity_view_kanban" model="ir.ui.view">
            <field name="name">vf.activity.kanban</field>
            <field name="model">vf.activity</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="display_name"/>
                    <field name="activity_type_id"/>
                    <field name="start_date"/>
                    <field name="state"/>
                    <field name="visibility"/>
                    <field name="participant_count"/>
                    <field name="available_spots"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="display_name"/>
                                            </strong>
                                            <div class="o_kanban_record_subtitle">
                                                <field name="activity_type_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="participant_count"/>/<field name="max_participants"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="start_date"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Activity Search View -->
        <record id="vf_activity_view_search" model="ir.ui.view">
            <field name="name">vf.activity.search</field>
            <field name="model">vf.activity</field>
            <field name="arch" type="xml">
                <search string="Search Activities">
                    <field name="name"/>
                    <field name="activity_type_id"/>
                    <field name="description"/>
                    <field name="start_date"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Planned" name="planned" domain="[('state', '=', 'planned')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <filter string="Open for Registration" name="open_registration" 
                            domain="[('allow_registration', '=', True), ('registration_start', '<=', context_today()), ('registration_end', '>=', context_today())]"/>
                    <filter string="My Activities" name="my_activities" 
                            domain="[('instructor_ids', 'in', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Activity Type" name="group_type" context="{'group_by': 'activity_type_id'}"/>
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Start Date" name="group_date" context="{'group_by': 'start_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Activity Action -->
        <record id="vf_activity_action" model="ir.actions.act_window">
            <field name="name">Activities</field>
            <field name="res_model">vf.activity</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_confirmed': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first activity!
                </p>
                <p>
                    Activities are events and programs that members can participate in.
                    They can be scheduled, require registration, and track attendance.
                </p>
            </field>
        </record>
        
        <!-- Activity Menu Items -->
        <menuitem id="vf_activity_menu" name="Activities" parent="vertical_association_sweden.vf_root_menu" 
                  sequence="30" action="vf_activity_action"/>
        <menuitem id="vf_activity_all_menu" name="All Activities" parent="vf_activity_menu" 
                  sequence="10" action="vf_activity_action"/>
    </data>
</odoo>
