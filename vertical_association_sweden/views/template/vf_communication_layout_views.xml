<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Communication Layout List View -->
        <record id="vf_communication_layout_view_tree" model="ir.ui.view">
            <field name="name">vf.communication.layout.tree</field>
            <field name="model">vf.communication.layout</field>
            <field name="arch" type="xml">
                <tree string="Communication Layouts">
                    <field name="display_name"/>
                    <field name="layout_type"/>
                    <field name="category_id"/>
                    <field name="is_default" widget="boolean_toggle"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Communication Layout Form View -->
        <record id="vf_communication_layout_view_form" model="ir.ui.view">
            <field name="name">vf.communication.layout.form</field>
            <field name="model">vf.communication.layout</field>
            <field name="arch" type="xml">
                <form string="Communication Layout">
                    <header>
                        <button name="action_preview" type="object" 
                                string="Preview Layout" class="btn-primary"/>
                        <button name="action_test_layout" type="object" 
                                string="Test Layout" class="btn-secondary"/>
                        <button name="action_set_as_default" type="object" 
                                string="Set as Default" class="btn-secondary"
                                attrs="{'invisible': [('is_default', '=', True)]}"/>
                        <field name="active" widget="boolean_toggle"/>
                        <field name="is_default" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="category_id"/>
                                <field name="layout_type"/>
                            </group>
                            <group>
                                <field name="export_orientation" 
                                       attrs="{'invisible': [('layout_type', 'not in', ['export_pdf', 'report'])]}"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                        
                        <notebook>
                            <page string="Header">
                                <group string="Header Content">
                                    <field name="header_html" nolabel="1" widget="html"/>
                                </group>
                            </page>
                            
                            <page string="Footer">
                                <group string="Footer Content">
                                    <field name="footer_html" nolabel="1" widget="html"/>
                                </group>
                            </page>
                            
                            <page string="Body">
                                <group string="Body Content">
                                    <field name="body_html" nolabel="1" widget="html"/>
                                </group>
                            </page>
                            
                            <page string="CSS">
                                <group string="Custom CSS">
                                    <field name="custom_css" nolabel="1"/>
                                </group>
                            </page>
                            
                            <page string="Settings" 
                                   attrs="{'invisible': [('layout_type', 'not in', ['export_pdf', 'report'])]}">
                                <group string="PDF Settings">
                                    <group>
                                        <field name="pdf_margin_top"/>
                                        <field name="pdf_margin_bottom"/>
                                        <field name="pdf_margin_left"/>
                                        <field name="pdf_margin_right"/>
                                    </group>
                                    <group>
                                        <field name="pdf_font_size"/>
                                        <field name="pdf_header_spacing"/>
                                        <field name="pdf_footer_spacing"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Communication Layout Search View -->
        <record id="vf_communication_layout_view_search" model="ir.ui.view">
            <field name="name">vf.communication.layout.search</field>
            <field name="model">vf.communication.layout</field>
            <field name="arch" type="xml">
                <search string="Search Communication Layouts">
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="layout_type"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <filter string="Default" name="default" domain="[('is_default', '=', True)]"/>
                    <filter string="Email" name="email" domain="[('layout_type', '=', 'email')]"/>
                    <filter string="PDF Export" name="pdf_export" domain="[('layout_type', '=', 'export_pdf')]"/>
                    <filter string="Report" name="report" domain="[('layout_type', '=', 'report')]"/>
                    <filter string="Newsletter" name="newsletter" domain="[('layout_type', '=', 'newsletter')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                        <filter string="Type" name="group_type" context="{'group_by': 'layout_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Communication Layout Action -->
        <record id="vf_communication_layout_action" model="ir.actions.act_window">
            <field name="name">Communication Layouts</field>
            <field name="res_model">vf.communication.layout</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first communication layout!
                </p>
                <p>
                    Communication layouts define the visual appearance of emails,
                    PDF exports, and other communications sent to members.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="vf_communication_layout_menu" name="Communication Layouts" 
                  parent="vf_template_menu_main" 
                  action="vf_communication_layout_action" sequence="40"/>
    </data>
</odoo>
