<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Document Template List View -->
        <record id="vf_document_template_view_tree" model="ir.ui.view">
            <field name="name">vf.document.template.tree</field>
            <field name="model">vf.document.template</field>
            <field name="arch" type="xml">
                <tree string="Document Templates">
                    <field name="display_name"/>
                    <field name="template_type"/>
                    <field name="category_id"/>
                    <field name="active"/>
                    <field name="usage_count" widget="integer"/>
                </tree>
            </field>
        </record>

        <!-- Document Template Form View -->
        <record id="vf_document_template_view_form" model="ir.ui.view">
            <field name="name">vf.document.template.form</field>
            <field name="model">vf.document.template</field>
            <field name="arch" type="xml">
                <form string="Document Template">
                    <header>
                        <button name="action_generate_preview" type="object" 
                                string="Generate Preview" class="btn-primary"/>
                        <button name="action_test_variables" type="object" 
                                string="Test Variables" class="btn-secondary"/>
                        <button name="action_create_document" type="object" 
                                string="Create Document" class="btn-secondary"/>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="category_id"/>
                                <field name="template_type"/>
                                <field name="usage_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="pdf_font_size" 
                                       attrs="{'invisible': [('template_type', 'not in', ['pdf_report', 'certificate', 'letter'])]}"/>
                                <field name="pdf_margin_top" 
                                       attrs="{'invisible': [('template_type', 'not in', ['pdf_report', 'certificate', 'letter'])]}"/>
                                <field name="pdf_margin_bottom" 
                                       attrs="{'invisible': [('template_type', 'not in', ['pdf_report', 'certificate', 'letter'])]}"/>
                                <field name="pdf_margin_left" 
                                       attrs="{'invisible': [('template_type', 'not in', ['pdf_report', 'certificate', 'letter'])]}"/>
                                <field name="pdf_margin_right" 
                                       attrs="{'invisible': [('template_type', 'not in', ['pdf_report', 'certificate', 'letter'])]}"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Content">
                                <group string="Template Variables">
                                    <field name="variable_ids" nolabel="1">
                                        <tree>
                                            <field name="name"/>
                                            <field name="variable_type"/>
                                            <field name="description"/>
                                            <field name="default_value"/>
                                        </tree>
                                    </field>
                                </group>
                                <group string="Template Content">
                                    <field name="content" nolabel="1"/>
                                </group>
                            </page>
                            
                            <page string="Header Footer">
                                <group string="Header">
                                    <field name="header_content" nolabel="1"/>
                                </group>
                                <group string="Footer">
                                    <field name="footer_content" nolabel="1"/>
                                </group>
                            </page>
                            
                            <page string="Preview">
                                <group>
                                    <field name="preview_html" nolabel="1" widget="html"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Document Template Search View -->
        <record id="vf_document_template_view_search" model="ir.ui.view">
            <field name="name">vf.document.template.search</field>
            <field name="model">vf.document.template</field>
            <field name="arch" type="xml">
                <search string="Search Document Templates">
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="template_type"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <filter string="PDF Reports" name="pdf_reports" domain="[('template_type', '=', 'pdf_report')]"/>
                    <filter string="Certificates" name="certificates" domain="[('template_type', '=', 'certificate')]"/>
                    <filter string="Letters" name="letters" domain="[('template_type', '=', 'letter')]"/>
                    <filter string="Forms" name="forms" domain="[('template_type', '=', 'form')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                        <filter string="Type" name="group_type" context="{'group_by': 'template_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Document Template Action -->
        <record id="vf_document_template_action" model="ir.actions.act_window">
            <field name="name">Document Templates</field>
            <field name="res_model">vf.document.template</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first document template!
                </p>
                <p>
                    Document templates allow you to create standardized documents
                    with variable content that can be filled in when needed.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="vf_document_template_menu" name="Document Templates" 
                  parent="vf_template_menu_main" 
                  action="vf_document_template_action" sequence="20"/>
    </data>
</odoo>
