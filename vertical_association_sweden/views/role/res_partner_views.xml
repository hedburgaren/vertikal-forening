<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Partner Form View Extension -->
        <record id="view_res_partner_form_inherit_vf_role" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.vf.role</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_id']" position="after">
                    <group name="vf_role_info" string="Association Roles" 
                           attrs="{'invisible': [('is_company', '=', True)]}">
                        <field name="has_active_mandates" readonly="1"/>
                        <field name="current_roles" readonly="1"/>
                        <field name="is_leader" readonly="1"/>
                        <field name="is_manager" readonly="1"/>
                        <button name="action_view_mandates" type="object" string="View Mandates" 
                                attrs="{'invisible': [('has_active_mandates', '=', False)]}" class="btn-link"/>
                        <button name="action_assign_mandate" type="object" string="Assign Mandate" 
                                class="btn-link"/>
                    </group>
                </xpath>
                
                <xpath expr="//notebook" position="inside">
                    <page string="Mandates" attrs="{'invisible': [('is_company', '=', True)]}">
                        <field name="mandate_ids">
                            <tree>
                                <field name="position_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="status"/>
                                <field name="appointed_by"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        
        <!-- Partner Kanban View Extension -->
        <record id="view_res_partner_kanban_inherit_vf_role" model="ir.ui.view">
            <field name="name">res.partner.kanban.inherit.vf.role</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.res_partner_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='display_name']" position="after">
                    <t t-if="record.has_active_mandates.raw_value">
                        <div class="oe_kanban_bottom_right">
                            <t t-if="record.is_manager.raw_value">
                                <span class="badge badge-warning">Manager</span>
                            </t>
                            <t t-elif="record.is_leader.raw_value">
                                <span class="badge badge-info">Leader</span>
                            </t>
                        </div>
                    </t>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
