<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Mandate List View -->
        <record id="vf_mandate_view_tree" model="ir.ui.view">
            <field name="name">vf.mandate.tree</field>
            <field name="model">vf.mandate</field>
            <field name="arch" type="xml">
                <tree string="Mandates">
                    <field name="display_name"/>
                    <field name="position_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="status"/>
                    <field name="appointed_by"/>
                    <field name="days_remaining" widget="float_time"/>
                </tree>
            </field>
        </record>
        
        <!-- Mandate Form View -->
        <record id="vf_mandate_view_form" model="ir.ui.view">
            <field name="name">vf.mandate.form</field>
            <field name="model">vf.mandate</field>
            <field name="arch" type="xml">
                <form string="Mandate">
                    <header>
                        <button name="action_activate" type="object" string="Activate" 
                                attrs="{'invisible': [('status', '!=', 'pending')]}" class="btn-primary"/>
                        <button name="action_revoke" type="object" string="Revoke" 
                                attrs="{'invisible': [('status', '=', 'revoked')]}"/>
                        <button name="action_extend" type="object" string="Extend" 
                                attrs="{'invisible': [('status', '!=', 'active')]}"/>
                        <field name="status" widget="statusbar" 
                               statusbar_visible="pending,active,expired,revoked"/>
                    </header>
                    <sheet>
                        <div class="alert alert-warning" 
                             attrs="{'invisible': [('is_expiring_soon', '=', False)]}">
                            <i class="fa fa-exclamation-triangle"/>
                            This mandate expires in <field name="days_remaining"/> days
                        </div>
                        
                        <group>
                            <group name="mandate_info">
                                <field name="person_id"/>
                                <field name="position_id"/>
                                <field name="appointed_by"/>
                                <field name="appointment_date"/>
                            </group>
                            <group name="dates">
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="is_expiring_soon" invisible="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Terms">
                                <group>
                                    <field name="terms" nolabel="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Mandate Kanban View -->
        <record id="vf_mandate_view_kanban" model="ir.ui.view">
            <field name="name">vf.mandate.kanban</field>
            <field name="model">vf.mandate</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status">
                    <field name="display_name"/>
                    <field name="position_id"/>
                    <field name="person_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="status"/>
                    <field name="is_expiring_soon"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_content">
                                    <div class="oe_kanban_primary_left">
                                        <img t-att-src="kanban_image('res.partner', 'image_small', record.person_id.raw_value)"
                                             class="oe_kanban_avatar"/>
                                    </div>
                                    <div class="oe_kanban_details">
                                        <div class="o_kanban_record_top">
                                            <div class="o_kanban_record_headings">
                                                <strong class="o_kanban_record_title">
                                                    <field name="display_name"/>
                                                </strong>
                                                <div class="o_kanban_record_subtitle">
                                                    <field name="position_id"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="o_kanban_record_bottom">
                                            <div class="oe_kanban_bottom_left">
                                                <field name="person_id"/>
                                            </div>
                                            <div class="oe_kanban_bottom_right">
                                                <t t-if="record.is_expiring_soon.raw_value">
                                                    <span class="badge badge-warning">Expiring Soon</span>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Mandate Search View -->
        <record id="vf_mandate_view_search" model="ir.ui.view">
            <field name="name">vf.mandate.search</field>
            <field name="model">vf.mandate</field>
            <field name="arch" type="xml">
                <search string="Search Mandates">
                    <field name="person_id"/>
                    <field name="position_id"/>
                    <field name="appointed_by"/>
                    <field name="status"/>
                    <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                    <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                    <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                    <filter string="Revoked" name="revoked" domain="[('status', '=', 'revoked')]"/>
                    <filter string="Expiring Soon" name="expiring_soon" 
                            domain="[('is_expiring_soon', '=', True)]"/>
                    <separator/>
                    <filter string="My Mandates" name="my_mandates" 
                            domain="[('person_id.partner_id.user_ids', 'in', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Position" name="group_position" context="{'group_by': 'position_id'}"/>
                        <filter string="Person" name="group_person" context="{'group_by': 'person_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Mandate Action -->
        <record id="vf_mandate_action" model="ir.actions.act_window">
            <field name="name">Mandates</field>
            <field name="res_model">vf.mandate</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first mandate!
                </p>
                <p>
                    Mandates assign positions to members for specific periods.
                    They track who holds which roles and when their terms expire.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_mandate_menu" name="Mandates" 
                  parent="vertical_association_sweden.vf_menu_organization" 
                  sequence="50"
                  action="vf_mandate_action"/>
    </data>
</odoo>
