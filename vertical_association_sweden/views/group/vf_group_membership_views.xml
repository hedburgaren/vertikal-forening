<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Group Membership List View -->
        <record id="vf_group_membership_view_tree" model="ir.ui.view">
            <field name="name">vf.group.membership.tree</field>
            <field name="model">vf.group.membership</field>
            <field name="arch" type="xml">
                <tree string="Group Memberships">
                    <field name="member_id"/>
                    <field name="group_id"/>
                    <field name="join_date"/>
                    <field name="leave_date"/>
                    <field name="is_active"/>
                    <field name="group_role"/>
                </tree>
            </field>
        </record>
        
        <!-- Group Membership Form View -->
        <record id="vf_group_membership_view_form" model="ir.ui.view">
            <field name="name">vf.group.membership.form</field>
            <field name="model">vf.group.membership</field>
            <field name="arch" type="xml">
                <form string="Group Membership">
                    <header>
                        <button name="action_leave_group" type="object" string="Leave Group" 
                                attrs="{'invisible': [('is_active', '=', False)]}"/>
                        <button name="action_reactivate" type="object" string="Reactivate" 
                                attrs="{'invisible': [('is_active', '=', True)]}"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group name="membership_info">
                                <field name="member_id"/>
                                <field name="group_id"/>
                                <field name="group_role"/>
                            </group>
                            <group name="dates">
                                <field name="join_date"/>
                                <field name="leave_date"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Notes" groups="vertical_association_sweden.group_vf_admin">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Group Membership Search View -->
        <record id="vf_group_membership_view_search" model="ir.ui.view">
            <field name="name">vf.group.membership.search</field>
            <field name="model">vf.group.membership</field>
            <field name="arch" type="xml">
                <search string="Search Group Memberships">
                    <field name="member_id"/>
                    <field name="group_id"/>
                    <field name="group_role"/>
                    <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                    <filter string="Ended" name="ended" domain="[('is_active', '=', False)]"/>
                    <filter string="Current Year" name="current_year" 
                            domain="[('join_date', '>=', (context_today() - datetime.timedelta(days=365)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Member" name="group_member" context="{'group_by': 'member_id'}"/>
                        <filter string="Group" name="group_group" context="{'group_by': 'group_id'}"/>
                        <filter string="Role" name="group_role" context="{'group_by': 'group_role'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Group Membership Action -->
        <record id="vf_group_membership_action" model="ir.actions.act_window">
            <field name="name">Group Memberships</field>
            <field name="res_model">vf.group.membership</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_group_id': active_id}</field>
        </record>
    </data>
</odoo>
