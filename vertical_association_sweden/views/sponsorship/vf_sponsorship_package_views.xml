<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sponsorship Level Tree View -->
        <record id="vf_sponsorship_level_view_tree" model="ir.ui.view">
            <field name="name">vf.sponsorship.level.tree</field>
            <field name="model">vf.sponsorship.level</field>
            <field name="arch" type="xml">
                <tree string="Sponsorship Levels">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="default_amount"/>
                    <field name="sponsor_count"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>
        
        <!-- Sponsorship Level Form View -->
        <record id="vf_sponsorship_level_view_form" model="ir.ui.view">
            <field name="name">vf.sponsorship.level.form</field>
            <field name="model">vf.sponsorship.level</field>
            <field name="arch" type="xml">
                <form string="Sponsorship Level">
                    <sheet>
                        <group>
                            <group name="level_info">
                                <field name="name" required="1"/>
                                <field name="sequence"/>
                                <field name="color" widget="color"/>
                            </group>
                            <group name="financial_info">
                                <field name="default_amount" required="1"/>
                                <field name="currency_id"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                            
                            <page string="Benefits">
                                <field name="benefit_ids" widget="many2many_tags"/>
                            </page>
                            
                            <page string="Visibility">
                                <group>
                                    <field name="show_on_website"/>
                                    <field name="show_logo"/>
                                    <field name="logo_size"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Sponsorship Level Action -->
        <record id="vf_sponsorship_level_action" model="ir.actions.act_window">
            <field name="name">Sponsorship Levels</field>
            <field name="res_model">vf.sponsorship.level</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first sponsorship level!
                </p>
                <p>
                    Sponsorship levels define different tiers of sponsorship
                    with associated benefits and recognition.
                </p>
            </field>
        </record>
        
        <!-- Sponsorship Benefit Tree View -->
        <record id="vf_sponsorship_benefit_view_tree" model="ir.ui.view">
            <field name="name">vf.sponsorship.benefit.tree</field>
            <field name="model">vf.sponsorship.benefit</field>
            <field name="arch" type="xml">
                <tree string="Sponsorship Benefits">
                    <field name="name"/>
                    <field name="category"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>
        
        <!-- Sponsorship Benefit Form View -->
        <record id="vf_sponsorship_benefit_view_form" model="ir.ui.view">
            <field name="name">vf.sponsorship.benefit.form</field>
            <field name="model">vf.sponsorship.benefit</field>
            <field name="arch" type="xml">
                <form string="Sponsorship Benefit">
                    <sheet>
                        <group>
                            <group name="benefit_info">
                                <field name="name"/>
                                <field name="category"/>
                            </group>
                            <group name="configuration">
                                <field name="active"/>
                            </group>
                        </group>
                        
                        <group string="Description">
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Sponsorship Benefit Action -->
        <record id="vf_sponsorship_benefit_action" model="ir.actions.act_window">
            <field name="name">Sponsorship Benefits</field>
            <field name="res_model">vf.sponsorship.benefit</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first sponsorship benefit!
                </p>
                <p>
                    Sponsorship benefits are the perks and recognition items
                    offered to sponsors at different levels.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_sponsorship_menu" name="Sponsorship" parent="vertical_association_sweden.vf_root_menu" 
                  sequence="60" action="vf_sponsor_action"/>
        <menuitem id="vf_sponsorship_package_menu" name="Packages" parent="vf_sponsorship_menu" 
                  sequence="10"/>
        <menuitem id="vf_sponsorship_level_menu" name="Sponsorship Levels" 
                  parent="vf_sponsorship_package_menu" action="vf_sponsorship_level_action"/>
        <menuitem id="vf_sponsorship_benefit_menu" name="Sponsorship Benefits" 
                  parent="vf_sponsorship_package_menu" action="vf_sponsorship_benefit_action"/>
    </data>
</odoo>
