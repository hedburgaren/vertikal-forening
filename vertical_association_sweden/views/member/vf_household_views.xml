<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Household List View -->
        <record id="vf_household_view_tree" model="ir.ui.view">
            <field name="name">vf.household.tree</field>
            <field name="model">vf.household</field>
            <field name="arch" type="xml">
                <tree string="Households">
                    <field name="display_name"/>
                    <field name="address_id"/>
                    <field name="member_count"/>
                    <field name="city"/>
                    <field name="phone"/>
                </tree>
            </field>
        </record>
        
        <!-- Household Form View -->
        <record id="vf_household_view_form" model="ir.ui.view">
            <field name="name">vf.household.form</field>
            <field name="model">vf.household</field>
            <field name="arch" type="xml">
                <form string="Household">
                    <header>
                        <button name="action_create_address" type="object" string="Create Address" 
                                attrs="{'invisible': [('address_id', '!=', False)]}"/>
                        <button name="action_view_members" type="object" string="View Members" 
                                class="btn-primary"/>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_members" type="object" 
                                    class="oe_stat_button" icon="fa-users">
                                <field name="member_count" widget="statinfo" 
                                       string="Members"/>
                            </button>
                        </div>
                        
                        <group>
                            <group name="household_info">
                                <field name="name"/>
                                <field name="address_id"/>
                            </group>
                            <group name="contact">
                                <field name="phone"/>
                                <field name="email"/>
                            </group>
                        </group>
                        
                        <group string="Address">
                            <group>
                                <field name="street"/>
                                <field name="street2"/>
                            </group>
                            <group>
                                <field name="zip"/>
                                <field name="city"/>
                                <field name="state_id"/>
                                <field name="country_id"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Members">
                                <field name="member_ids">
                                    <tree>
                                        <field name="membership_number"/>
                                        <field name="partner_id"/>
                                        <field name="age"/>
                                        <field name="is_minor"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Household Search View -->
        <record id="vf_household_view_search" model="ir.ui.view">
            <field name="name">vf.household.search</field>
            <field name="model">vf.household</field>
            <field name="arch" type="xml">
                <search string="Search Households">
                    <field name="name"/>
                    <field name="address_id"/>
                    <field name="city"/>
                    <field name="zip"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <filter string="Has Members" name="has_members" domain="[('member_count', '>', 0)]"/>
                    <filter string="Empty Households" name="empty" domain="[('member_count', '=', 0)]"/>
                    <group expand="0" string="Group By">
                        <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
                        <filter string="State" name="group_state" context="{'group_by': 'state_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Household Action -->
        <record id="vf_household_action" model="ir.actions.act_window">
            <field name="name">Households</field>
            <field name="res_model">vf.household</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first household!
                </p>
                <p>
                    Households group members living at the same address. This helps manage 
                    family units and shared contact information.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_household_menu" name="Households" 
                  parent="vertical_association_sweden.vf_menu_association" 
                  sequence="20"
                  action="vf_household_action"/>
    </data>
</odoo>
