<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Member List View -->
        <record id="vf_member_view_tree" model="ir.ui.view">
            <field name="name">vf.member.tree</field>
            <field name="model">vf.member</field>
            <field name="arch" type="xml">
                <tree string="Members">
                    <field name="membership_number"/>
                    <field name="partner_id"/>
                    <field name="birth_date"/>
                    <field name="age"/>
                    <field name="is_minor"/>
                    <field name="status"/>
                    <field name="membership_date"/>
                    <field name="household_id"/>
                </tree>
            </field>
        </record>
        
        <!-- Member Form View -->
        <record id="vf_member_view_form" model="ir.ui.view">
            <field name="name">vf.member.form</field>
            <field name="model">vf.member</field>
            <field name="arch" type="xml">
                <form string="Member">
                    <header>
                        <button name="action_activate" type="object" string="Activate" 
                                attrs="{'invisible': [('active', '=', True)]}" class="btn-primary"/>
                        <button name="action_archive" type="object" string="Archive" 
                                attrs="{'invisible': [('active', '=', False)]}"/>
                        <field name="status" widget="statusbar" 
                               statusbar_visible="active,inactive,suspended,archived"/>
                        <field name="active" invisible="1"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_guardians" type="object" 
                                    class="oe_stat_button" icon="fa-users"
                                    attrs="{'invisible': [('is_minor', '=', False)]}">
                                <field name="guardian_ids" widget="statinfo" 
                                       string="Guardians" help="Number of active guardians"/>
                            </button>
                            <button name="action_view_groups" type="object" 
                                    class="oe_stat_button" icon="fa-sitemap">
                                <field name="group_membership_ids" widget="statinfo" 
                                       string="Groups" help="Number of group memberships"/>
                            </button>
                        </div>
                        <group>
                            <group name="basic_info">
                                <field name="membership_number"/>
                                <field name="partner_id"/>
                                <field name="birth_date"/>
                                <field name="age"/>
                                <field name="is_minor"/>
                                <field name="gender"/>
                                <field name="nationality"/>
                            </group>
                            <group name="membership_info">
                                <field name="status"/>
                                <field name="membership_date"/>
                                <field name="membership_end_date"/>
                                <field name="household_id"/>
                                <field name="member_category_ids"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Contact Information">
                                <group>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="address"/>
                                </group>
                            </page>
                            <page string="Guardians" attrs="{'invisible': [('is_minor', '=', False)]}">
                                <field name="guardian_ids">
                                    <tree>
                                        <field name="guardian_id"/>
                                        <field name="relationship_type_id"/>
                                        <field name="is_primary"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Groups">
                                <field name="group_membership_ids">
                                    <tree>
                                        <field name="group_id"/>
                                        <field name="role"/>
                                        <field name="join_date"/>
                                        <field name="leave_date"/>
                                        <field name="is_active"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Activities">
                                <field name="activity_registration_ids">
                                    <tree>
                                        <field name="activity_id"/>
                                        <field name="registration_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Fees">
                                <field name="fee_ids">
                                    <tree>
                                        <field name="fee_type_id"/>
                                        <field name="date_due"/>
                                        <field name="amount"/>
                                        <field name="paid_amount"/>
                                        <field name="remaining_amount"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Member Kanban View -->
        <record id="vf_member_view_kanban" model="ir.ui.view">
            <field name="name">vf.member.kanban</field>
            <field name="model">vf.member</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status">
                    <field name="membership_number"/>
                    <field name="partner_id"/>
                    <field name="age"/>
                    <field name="is_minor"/>
                    <field name="status"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_content">
                                    <div class="oe_kanban_primary_left">
                                        <img t-att-src="kanban_image('res.partner', 'image_small', record.partner_id.raw_value)"
                                             class="oe_kanban_avatar"/>
                                    </div>
                                    <div class="oe_kanban_details">
                                        <div class="o_kanban_record_top">
                                            <div class="o_kanban_record_headings">
                                                <strong class="o_kanban_record_title">
                                                    <field name="partner_id"/>
                                                </strong>
                                                <div class="o_kanban_record_subtitle">
                                                    <field name="membership_number"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="o_kanban_record_bottom">
                                            <div class="oe_kanban_bottom_left">
                                                <field name="age"/> years
                                            </div>
                                            <div class="oe_kanban_bottom_right">
                                                <field name="status"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Member Search View -->
        <record id="vf_member_view_search" model="ir.ui.view">
            <field name="name">vf.member.search</field>
            <field name="model">vf.member</field>
            <field name="arch" type="xml">
                <search string="Members">
                    <field name="membership_number"/>
                    <field name="partner_id"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="status"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="Minors" name="minors" domain="[('is_minor', '=', True)]"/>
                    <filter string="Adults" name="adults" domain="[('is_minor', '=', False)]"/>
                    <separator/>
                    <filter string="Created Today" name="today" 
                            domain="[('create_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                    <separator/>
                    <filter string="My Groups" name="my_groups" 
                            domain="[('group_membership_ids.group_id.user_ids', 'in', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Age Group" name="group_age" context="{'group_by': 'age_group'}"/>
                        <filter string="Household" name="group_household" context="{'group_by': 'household_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Member Action -->
        <record id="vf_member_action" model="ir.actions.act_window">
            <field name="name">Members</field>
            <field name="res_model">vf.member</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first member!
                </p>
                <p>
                    Members are the core of your association. Use this menu to manage
                    member information, memberships, and activities.
                </p>
            </field>
        </record>
        
        <!-- Member Menu Items -->
        <menuitem id="vf_member_menu" name="Members" parent="vertical_association_sweden.vf_root_menu" 
                  sequence="10" action="vf_member_action"/>
        <menuitem id="vf_member_all_menu" name="All Members" parent="vf_member_menu" 
                  sequence="10" action="vf_member_action"/>
    </data>
</odoo>
