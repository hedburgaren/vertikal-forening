<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Guardian Relationship List View -->
        <record id="vf_guardian_relationship_view_tree" model="ir.ui.view">
            <field name="name">vf.guardian.relationship.tree</field>
            <field name="model">vf.guardian.relationship</field>
            <field name="arch" type="xml">
                <tree string="Guardian Relationships">
                    <field name="member_id"/>
                    <field name="guardian_id"/>
                    <field name="relationship_type_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="is_active"/>
                    <field name="is_primary"/>
                    <field name="is_emergency"/>
                </tree>
            </field>
        </record>
        
        <!-- Guardian Relationship Form View -->
        <record id="vf_guardian_relationship_view_form" model="ir.ui.view">
            <field name="name">vf.guardian.relationship.form</field>
            <field name="model">vf.guardian.relationship</field>
            <field name="arch" type="xml">
                <form string="Guardian Relationship">
                    <header>
                        <button name="action_end_relationship" type="object" string="End Relationship" 
                                attrs="{'invisible': [('is_active', '=', False)]}"/>
                        <button name="action_reactivate" type="object" string="Reactivate" 
                                attrs="{'invisible': [('is_active', '=', True)]}"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group name="relationship_info">
                                <field name="member_id"/>
                                <field name="guardian_id"/>
                                <field name="relationship_type_id"/>
                                <field name="sequence"/>
                            </group>
                            <group name="dates">
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="is_primary" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Contact Information">
                            <group>
                                <field name="is_emergency"/>
                                <field name="legal_custody"/>
                            </group>
                            <group>
                                <field name="emergency_phone" 
                                       placeholder="Override guardian's phone for emergencies"/>
                                <field name="emergency_email" 
                                       placeholder="Override guardian's email for emergencies"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Notes" groups="vertical_association_sweden.group_vf_admin">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Guardian Relationship Search View -->
        <record id="vf_guardian_relationship_view_search" model="ir.ui.view">
            <field name="name">vf.guardian.relationship.search</field>
            <field name="model">vf.guardian.relationship</field>
            <field name="arch" type="xml">
                <search string="Search Guardian Relationships">
                    <field name="member_id"/>
                    <field name="guardian_id"/>
                    <field name="relationship_type_id"/>
                    <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                    <filter string="Ended" name="ended" domain="[('is_active', '=', False)]"/>
                    <filter string="Primary Guardians" name="primary" domain="[('is_primary', '=', True)]"/>
                    <filter string="Emergency Contacts" name="emergency" domain="[('is_emergency', '=', True)]"/>
                    <filter string="Legal Custody" name="custody" domain="[('legal_custody', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Member" name="group_member" context="{'group_by': 'member_id'}"/>
                        <filter string="Guardian" name="group_guardian" context="{'group_by': 'guardian_id'}"/>
                        <filter string="Relationship Type" name="group_type" context="{'group_by': 'relationship_type_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Guardian Relationship Action -->
        <record id="vf_guardian_relationship_action" model="ir.actions.act_window">
            <field name="name">Guardian Relationships</field>
            <field name="res_model">vf.guardian.relationship</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_member_id': active_id}</field>
        </record>
    </data>
</odoo>
