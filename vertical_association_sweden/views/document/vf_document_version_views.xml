<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Document Version List View -->
        <record id="vf_document_version_view_tree" model="ir.ui.view">
            <field name="name">vf.document.version.tree</field>
            <field name="model">vf.document.version</field>
            <field name="arch" type="xml">
                <tree string="Document Versions">
                    <field name="display_name"/>
                    <field name="version"/>
                    <field name="created_date"/>
                    <field name="created_by"/>
                    <field name="file_size"/>
                    <field name="is_current"/>
                </tree>
            </field>
        </record>
        
        <!-- Document Version Form View -->
        <record id="vf_document_version_view_form" model="ir.ui.view">
            <field name="name">vf.document.version.form</field>
            <field name="model">vf.document.version</field>
            <field name="arch" type="xml">
                <form string="Document Version">
                    <header>
                        <button name="action_download" type="object" string="Download" class="btn-primary"/>
                        <button name="action_view_file" type="object" string="View"/>
                        <button name="action_restore" type="object" string="Restore as Current" 
                                attrs="{'invisible': [('is_current', '=', True)]}"/>
                        <field name="is_current" widget="boolean_toggle" readonly="1"/>
                    </header>
                    <sheet>
                        <group>
                            <group name="version_info">
                                <field name="document_id"/>
                                <field name="version"/>
                                <field name="created_date"/>
                                <field name="created_by"/>
                            </group>
                            <group name="file_info">
                                <field name="attachment_id"/>
                                <field name="file_size" readonly="1"/>
                                <field name="file_type" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Changelog">
                            <field name="changelog" nolabel="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Document Version Action -->
        <record id="vf_document_version_action" model="ir.actions.act_window">
            <field name="name">Document Versions</field>
            <field name="res_model">vf.document.version</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
