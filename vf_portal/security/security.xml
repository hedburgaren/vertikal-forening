<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Security Groups -->
        <record id="group_portal_member" model="res.groups">
            <field name="name">Portal Member</field>
            <field name="category_id" ref="vf_base.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        
        <record id="group_portal_manager" model="res.groups">
            <field name="name">Portal Manager</field>
            <field name="category_id" ref="vf_base.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('group_portal_member'))]"/>
        </record>
        
        <!-- Record Rules -->
        <record id="rule_portal_member_own" model="ir.rule">
            <field name="name">Portal Member: Own Access</field>
            <field name="model_id" ref="model_vf_portal_member"/>
            <field name="domain_force">[('member_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_portal_member'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="rule_portal_activity_own" model="ir.rule">
            <field name="name">Portal Activity: Own Registrations</field>
            <field name="model_id" ref="model_vf_portal_activity"/>
            <field name="domain_force">[('member_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_portal_member'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="rule_portal_payment_own" model="ir.rule">
            <field name="name">Portal Payment: Own Payments</field>
            <field name="model_id" ref="model_vf_portal_payment"/>
            <field name="domain_force">[('fee_id.member_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_portal_member'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
