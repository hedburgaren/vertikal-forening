<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Member Economy Extension Form View -->
        <record id="vf_member_view_form_economy" model="ir.ui.view">
            <field name="name">vf.member.form.economy</field>
            <field name="model">vf.member</field>
            <field name="inherit_id" ref="vf_member.vf_member_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='administrative']" position="after">
                    <page string="Economy">
                        <group>
                            <group name="economy_summary">
                                <field name="total_fees" readonly="1"/>
                                <field name="total_paid" readonly="1"/>
                                <field name="total_outstanding" readonly="1"/>
                                <field name="overdue_amount" readonly="1"/>
                            </group>
                            <group name="payment_info">
                                <field name="last_payment_date" readonly="1"/>
                                <field name="payment_status" readonly="1"/>
                            </group>
                        </group>
                        
                        <div class="oe_button_box" name="economy_buttons">
                            <button name="action_view_fees" type="object" 
                                    class="oe_stat_button" icon="fa-money">
                                <field name="economy_count" widget="statinfo" 
                                       string="Fees" help="Number of fee records"/>
                            </button>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>
        
        <!-- Member Tree View Extension -->
        <record id="vf_member_view_tree_economy" model="ir.ui.view">
            <field name="name">vf.member.tree.economy</field>
            <field name="model">vf.member</field>
            <field name="inherit_id" ref="vf_member.vf_member_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="inside">
                    <field name="total_outstanding" optional="show"/>
                    <field name="payment_status" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
