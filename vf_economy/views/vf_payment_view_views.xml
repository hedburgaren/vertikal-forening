<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Payment View Tree View -->
        <record id="vf_payment_view_view_tree" model="ir.ui.view">
            <field name="name">vf.payment.view.tree</field>
            <field name="model">vf.payment.view</field>
            <field name="arch" type="xml">
                <tree string="Payment Views">
                    <field name="name"/>
                    <field name="date_range"/>
                    <field name="show_overdue_only"/>
                    <field name="member_count"/>
                    <field name="total_amount"/>
                    <field name="outstanding_amount"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>
        
        <!-- Payment View Form View -->
        <record id="vf_payment_view_view_form" model="ir.ui.view">
            <field name="name">vf.payment.view.form</field>
            <field name="model">vf.payment.view</field>
            <field name="arch" type="xml">
                <form string="Payment View">
                    <sheet>
                        <group>
                            <group name="view_info">
                                <field name="name"/>
                                <field name="description"/>
                                <field name="date_range"/>
                                <field name="group_by"/>
                            </group>
                            <group name="filters">
                                <field name="show_overdue_only"/>
                                <field name="show_partial_payments"/>
                                <field name="min_amount"/>
                                <field name="max_amount"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Filters">
                                <group>
                                    <field name="section_ids" widget="many2many_tags"/>
                                    <field name="group_ids" widget="many2many_tags"/>
                                    <field name="fee_category_ids" widget="many2many_tags"/>
                                </group>
                            </page>
                            
                            <page string="Statistics">
                                <group>
                                    <field name="member_count" readonly="1"/>
                                    <field name="total_amount" readonly="1"/>
                                    <field name="paid_amount" readonly="1"/>
                                    <field name="outstanding_amount" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Payment View Search View -->
        <record id="vf_payment_view_view_search" model="ir.ui.view">
            <field name="name">vf.payment.view.search</field>
            <field name="model">vf.payment.view</field>
            <field name="arch" type="xml">
                <search string="Payment Views">
                    <field name="name"/>
                    <field name="description"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Overdue Only" name="overdue" domain="[('show_overdue_only', '=', True)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Date Range" name="group_date_range" context="{'group_by': 'date_range'}"/>
                        <filter string="Group By" name="group_by" context="{'group_by': 'group_by'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Payment View Action -->
        <record id="vf_payment_view_action" model="ir.actions.act_window">
            <field name="name">Payment Views</field>
            <field name="res_model">vf.payment.view</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first payment view
                </p>
                <p>
                    Define filtered views of payment data for analysis and reporting.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_payment_view_menu" name="Payment Views" parent="vf_economy_menu_root" sequence="20"/>
        <menuitem id="vf_payment_view_menu_list" name="All Views" parent="vf_payment_view_menu" 
                  action="vf_payment_view_action" sequence="10"/>
    </data>
</odoo>
