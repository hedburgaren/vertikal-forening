<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Economy Report Tree View -->
        <record id="vf_economy_report_view_tree" model="ir.ui.view">
            <field name="name">vf.economy.report.tree</field>
            <field name="model">vf.economy.report</field>
            <field name="arch" type="xml">
                <tree string="Economy Reports">
                    <field name="name"/>
                    <field name="report_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="date_generated"/>
                    <field name="generated_by"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        
        <!-- Economy Report Form View -->
        <record id="vf_economy_report_view_form" model="ir.ui.view">
            <field name="name">vf.economy.report.form</field>
            <field name="model">vf.economy.report</field>
            <field name="arch" type="xml">
                <form string="Economy Report">
                    <header>
                        <button name="action_generate" type="object" string="Generate Report" 
                                attrs="{'invisible': [('state', '!=', 'draft')]}" class="btn-primary"/>
                        <button name="action_export" type="object" string="Export" 
                                attrs="{'invisible': [('state', '!=', 'generated')]}" class="btn-secondary"/>
                        <button name="action_archive" type="object" string="Archive" 
                                attrs="{'invisible': [('state', '=', 'archived')]}" class="btn-warning"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group name="report_info">
                                <field name="name"/>
                                <field name="report_type"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <group name="generation_info">
                                <field name="date_generated" readonly="1"/>
                                <field name="generated_by" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Filters">
                                <group>
                                    <field name="section_ids" widget="many2many_tags"/>
                                    <field name="group_ids" widget="many2many_tags"/>
                                    <field name="fee_category_ids" widget="many2many_tags"/>
                                </group>
                            </page>
                            
                            <page string="Data">
                                <field name="report_data" widget="text" readonly="1"/>
                            </page>
                            
                            <page string="Attachment">
                                <field name="attachment_id" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Economy Report Search View -->
        <record id="vf_economy_report_view_search" model="ir.ui.view">
            <field name="name">vf.economy.report.search</field>
            <field name="model">vf.economy.report</field>
            <field name="arch" type="xml">
                <search string="Economy Reports">
                    <field name="name"/>
                    <field name="report_type"/>
                    <field name="date_generated"/>
                    <field name="generated_by"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Generated" name="generated" domain="[('state', '=', 'generated')]"/>
                    <separator/>
                    <filter string="My Reports" name="my_reports" domain="[('generated_by', '=', uid)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Report Type" name="group_report_type" context="{'group_by': 'report_type'}"/>
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Generated By" name="group_generated_by" context="{'group_by': 'generated_by'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Economy Report Action -->
        <record id="vf_economy_report_action" model="ir.actions.act_window">
            <field name="name">Economy Reports</field>
            <field name="res_model">vf.economy.report</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first economy report
                </p>
                <p>
                    Generate financial reports including revenue, payment status, and age analysis.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_economy_menu_root" name="Economy" parent="vf_base.vf_association_menu" sequence="60"/>
        <menuitem id="vf_economy_report_menu" name="Reports" parent="vf_economy_menu_root" sequence="10"/>
        <menuitem id="vf_economy_report_menu_list" name="All Reports" parent="vf_economy_report_menu" 
                  action="vf_economy_report_action" sequence="10"/>
    </data>
</odoo>
