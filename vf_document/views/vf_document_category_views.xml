<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Document Category List View -->
        <record id="vf_document_category_view_tree" model="ir.ui.view">
            <field name="name">vf.document.category.tree</field>
            <field name="model">vf.document.category</field>
            <field name="arch" type="xml">
                <tree string="Document Categories">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="default_visibility"/>
                    <field name="allow_templates"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>
        
        <!-- Document Category Form View -->
        <record id="vf_document_category_view_form" model="ir.ui.view">
            <field name="name">vf.document.category.form</field>
            <field name="model">vf.document.category</field>
            <field name="arch" type="xml">
                <form string="Document Category">
                    <sheet>
                        <group>
                            <group name="category_info">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="sequence"/>
                            </group>
                            <group name="configuration">
                                <field name="default_visibility"/>
                                <field name="allow_templates"/>
                                <field name="active"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Description">
                                <field name="description" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Document Category Action -->
        <record id="vf_document_category_action" model="ir.actions.act_window">
            <field name="name">Document Categories</field>
            <field name="res_model">vf.document.category</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first document category!
                </p>
                <p>
                    Document categories help organize your association documents
                    by type and purpose.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_document_category_menu" name="Categories" 
                  parent="vf_base.vf_menu_association" 
                  sequence="60"
                  action="vf_document_category_action"/>
    </data>
</odoo>
