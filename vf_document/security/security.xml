<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rules -->
        <!-- Documents: Users can see public documents and their accessible documents -->
        <record id="rule_vf_document_user" model="ir.rule">
            <field name="name">VF Document: Accessible Documents</field>
            <field name="model_id" ref="model_vf_document"/>
            <field name="domain_force">['|', ('visibility', '=', 'public'), ('id', 'in', user.partner_id.accessible_document_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('vf_base.group_vf_user'))]"/>
        </record>
        
        <!-- Documents: Leaders can see documents in their scope -->
        <record id="rule_vf_document_leader" model="ir.rule">
            <field name="name">VF Document: Scope Documents</field>
            <field name="model_id" ref="model_vf_document"/>
            <field name="domain_force">['|', ('visibility', 'in', ['public', 'members']), ('allowed_group_ids.leader_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('vf_base.group_vf_leader'))]"/>
        </record>
        
        <!-- Documents: Admins can see all -->
        <record id="rule_vf_document_admin" model="ir.rule">
            <field name="name">VF Document: All</field>
            <field name="model_id" ref="model_vf_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vf_base.group_vf_admin'))]"/>
        </record>
        
        <!-- Document Versions: Inherit from document rules -->
        <record id="rule_vf_document_version_user" model="ir.rule">
            <field name="name">VF Document Version: Accessible</field>
            <field name="model_id" ref="model_vf_document_version"/>
            <field name="domain_force">[('document_id.id', 'in', user.partner_id.accessible_document_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('vf_base.group_vf_user'))]"/>
        </record>
        
        <record id="rule_vf_document_version_admin" model="ir.rule">
            <field name="name">VF Document Version: All</field>
            <field name="model_id" ref="model_vf_document_version"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vf_base.group_vf_admin'))]"/>
        </record>
        
        <!-- Document Categories: Everyone can read, only admins can write -->
        <record id="rule_vf_document_category_admin" model="ir.rule">
            <field name="name">VF Document Category: Admin Only</field>
            <field name="model_id" ref="model_vf_document_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vf_base.group_vf_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
