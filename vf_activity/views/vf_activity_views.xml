<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Activity List View -->
        <record id="vf_activity_view_tree" model="ir.ui.view">
            <field name="name">vf.activity.tree</field>
            <field name="model">vf.activity</field>
            <field name="arch" type="xml">
                <tree string="Activities">
                    <field name="display_name"/>
                    <field name="activity_type_id"/>
                    <field name="start_date"/>
                    <field name="state"/>
                    <field name="visibility"/>
                    <field name="participant_count"/>
                    <field name="available_spots"/>
                </tree>
            </field>
        </record>
        
        <!-- Activity Form View -->
        <record id="vf_activity_view_form" model="ir.ui.view">
            <field name="name">vf.activity.form</field>
            <field name="model">vf.activity</field>
            <field name="arch" type="xml">
                <form string="Activity">
                    <header>
                        <button name="action_plan" type="object" string="Plan" 
                                attrs="{'invisible': [('state', '!=', 'draft')]}" class="btn-primary"/>
                        <button name="action_confirm" type="object" string="Confirm" 
                                attrs="{'invisible': [('state', 'not in', ['draft', 'planned'])]}"/>
                        <button name="action_start" type="object" string="Start" 
                                attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                        <button name="action_complete" type="object" string="Complete" 
                                attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                        <button name="action_cancel" type="object" string="Cancel" 
                                attrs="{'invisible': [('state', '=', 'cancelled')]}"/>
                        <button name="action_set_to_draft" type="object" string="Set to Draft" 
                                attrs="{'invisible': [('state', '=', 'draft')]}"/>
                        <button name="action_view_schedule" type="object" string="Schedule"/>
                        <button name="action_view_participants" type="object" string="Participants"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,planned,confirmed,in_progress,completed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_participants" type="object" 
                                    class="oe_stat_button" icon="fa-users">
                                <field name="participant_count" widget="statinfo" 
                                       string="Participants"/>
                            </button>
                            <button name="action_view_schedule" type="object" 
                                    class="oe_stat_button" icon="fa-calendar">
                                <span>Schedules</span>
                            </button>
                        </div>
                        
                        <group>
                            <group name="activity_info">
                                <field name="name"/>
                                <field name="activity_type_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="all_day"/>
                                <field name="location"/>
                            </group>
                            <group name="status_info">
                                <field name="visibility"/>
                                <field name="duration" readonly="1"/>
                                <field name="is_past" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Organization">
                            <field name="organizer_id"/>
                            <field name="section_id"/>
                            <field name="group_id"/>
                        </group>
                        
                        <notebook>
                            <page string="Description">
                                <field name="description" nolabel="1"/>
                            </page>
                            
                            <page string="Registration">
                                <group>
                                    <field name="allow_registration"/>
                                    <field name="require_approval"/>
                                    <field name="max_participants"/>
                                    <field name="registration_deadline"/>
                                </group>
                            </page>
                            
                            <page string="Visibility" attrs="{'invisible': [('visibility', '!=', 'custom')]}">
                                <group string="Custom Visibility">
                                    <field name="allowed_member_ids" widget="many2many_tags"/>
                                </group>
                            </page>
                            
                            <page string="Resources">
                                <field name="resource_ids" widget="many2many_tags"/>
                            </page>
                            
                            <page string="Documents">
                                <field name="document_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="category_id"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Activity Search View -->
        <record id="vf_activity_view_search" model="ir.ui.view">
            <field name="name">vf.activity.search</field>
            <field name="model">vf.activity</field>
            <field name="arch" type="xml">
                <search string="Search Activities">
                    <field name="name"/>
                    <field name="activity_type_id"/>
                    <field name="location"/>
                    <field name="organizer_id"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Planned" name="planned" domain="[('state', '=', 'planned')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="Upcoming" name="upcoming" 
                            domain="[('start_date', '>=', context_today())]"/>
                    <filter string="Past" name="past" 
                            domain="[('end_date', '<', context_today())]"/>
                    <filter string="This Week" name="this_week" 
                            domain="[('start_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d')), ('start_date', '<=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter string="My Activities" name="my_activities" 
                            domain="[('organizer_id', '=', user.partner_id.id)]"/>
                    <filter string="Public" name="public" domain="[('visibility', '=', 'public')]"/>
                    <filter string="Registration Open" name="registration_open" 
                            domain="[('allow_registration', '=', True), ('state', 'in', ['planned', 'confirmed'])]"/>
                    <group expand="0" string="Group By">
                        <filter string="Activity Type" name="group_type" context="{'group_by': 'activity_type_id'}"/>
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Organizer" name="group_organizer" context="{'group_by': 'organizer_id'}"/>
                        <filter string="Month" name="group_month" context="{'group_by': 'start_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Activity Calendar View -->
        <record id="vf_activity_view_calendar" model="ir.ui.view">
            <field name="name">vf.activity.calendar</field>
            <field name="model">vf.activity</field>
            <field name="arch" type="xml">
                <calendar string="Activities" date_start="start_date" date_stop="end_date"
                         color="activity_type_id" mode="month" all_day="all_day">
                    <field name="name"/>
                    <field name="location"/>
                    <field name="state"/>
                    <field name="visibility"/>
                </calendar>
            </field>
        </record>
        
        <!-- Activity Action -->
        <record id="vf_activity_action" model="ir.actions.act_window">
            <field name="name">Activities</field>
            <field name="res_model">vf.activity</field>
            <field name="view_mode">calendar,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first activity!
                </p>
                <p>
                    Activities are events and programs organized by the association.
                    They can be scheduled with resources and allow member registration.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_activity_menu" name="Activities" 
                  parent="vf_base.vf_menu_association" 
                  sequence="65"
                  action="vf_activity_action"/>
    </data>
</odoo>
