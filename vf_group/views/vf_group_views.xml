<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Group List View -->
        <record id="vf_group_view_tree" model="ir.ui.view">
            <field name="name">vf.group.tree</field>
            <field name="model">vf.group</field>
            <field name="arch" type="xml">
                <tree string="Groups">
                    <field name="display_name"/>
                    <field name="section_id"/>
                    <field name="group_type_id"/>
                    <field name="leader_id"/>
                    <field name="active_member_count"/>
                    <field name="max_members"/>
                    <field name="is_active"/>
                </tree>
            </field>
        </record>
        
        <!-- Group Form View -->
        <record id="vf_group_view_form" model="ir.ui.view">
            <field name="name">vf.group.form</field>
            <field name="model">vf.group</field>
            <field name="arch" type="xml">
                <form string="Group">
                    <header>
                        <button name="action_add_members" type="object" string="Add Members" 
                                class="btn-primary"/>
                        <button name="action_view_members" type="object" string="View Members"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_members" type="object" 
                                    class="oe_stat_button" icon="fa-users">
                                <field name="active_member_count" widget="statinfo" 
                                       string="Active Members"/>
                            </button>
                            <button name="action_view_members" type="object" 
                                    class="oe_stat_button" icon="fa-users">
                                <field name="member_count" widget="statinfo" 
                                       string="Total Members"/>
                            </button>
                        </div>
                        
                        <group>
                            <group name="group_info">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="section_id"/>
                                <field name="group_type_id"/>
                                <field name="leader_id"/>
                            </group>
                            <group name="restrictions">
                                <field name="max_members"/>
                                <field name="min_age"/>
                                <field name="max_age"/>
                            </group>
                        </group>
                        
                        <group string="Hierarchy">
                            <group>
                                <field name="parent_group_id"/>
                            </group>
                            <group>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Description">
                                <field name="description" nolabel="1"/>
                            </page>
                            
                            <page string="Members">
                                <field name="member_ids">
                                    <tree>
                                        <field name="member_id"/>
                                        <field name="join_date"/>
                                        <field name="leave_date"/>
                                        <field name="is_active"/>
                                        <field name="group_role"/>
                                    </tree>
                                </field>
                            </page>
                            
                            <page string="Positions">
                                <field name="position_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="role_id"/>
                                        <field name="max_holders"/>
                                        <field name="is_active"/>
                                    </tree>
                                </field>
                            </page>
                            
                            <page string="Child Groups">
                                <field name="child_group_ids">
                                    <tree>
                                        <field name="display_name"/>
                                        <field name="group_type_id"/>
                                        <field name="leader_id"/>
                                        <field name="active_member_count"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Group Search View -->
        <record id="vf_group_view_search" model="ir.ui.view">
            <field name="name">vf.group.search</field>
            <field name="model">vf.group</field>
            <field name="arch" type="xml">
                <search string="Search Groups">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="section_id"/>
                    <field name="leader_id"/>
                    <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('is_active', '=', False)]"/>
                    <filter string="Has Capacity" name="has_capacity" 
                            domain="[('active_member_count', '&lt;', 'max_members')]"/>
                    <filter string="Full" name="full" 
                            domain="[('active_member_count', '>=', 'max_members')]"/>
                    <separator/>
                    <filter string="My Groups" name="my_groups" 
                            domain="[('leader_id', '=', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Section" name="group_section" context="{'group_by': 'section_id'}"/>
                        <filter string="Type" name="group_type" context="{'group_by': 'group_type_id'}"/>
                        <filter string="Leader" name="group_leader" context="{'group_by': 'leader_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Group Kanban View -->
        <record id="vf_group_view_kanban" model="ir.ui.view">
            <field name="name">vf.group.kanban</field>
            <field name="model">vf.group</field>
            <field name="arch" type="xml">
                <kanban string="Groups" default_group_by="section_id">
                    <field name="id"/>
                    <field name="display_name"/>
                    <field name="section_id"/>
                    <field name="group_type_id"/>
                    <field name="active_member_count"/>
                    <field name="max_members"/>
                    <field name="leader_id"/>
                    <field name="is_active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="display_name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="active_member_count"/>/<field name="max_members"/> members
                                            <t t-if="record.active_member_count.raw_value >= record.max_members.raw_value">
                                                <span class="badge badge-danger">Full</span>
                                            </t>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <img t-att-src="kanban_image('res.partner', 'image_128', record.leader_id.raw_value)" 
                                                 t-att-title="record.leader_id.value" 
                                                 t-att-alt="record.leader_id.value" 
                                                 class="oe_kanban_avatar"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Group Action -->
        <record id="vf_group_action" model="ir.actions.act_window">
            <field name="name">Groups</field>
            <field name="res_model">vf.group</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first group!
                </p>
                <p>
                    Groups are teams, committees, or working groups within sections.
                    Members can belong to multiple groups simultaneously.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_group_menu" name="Groups" 
                  parent="vf_base.vf_menu_organization" 
                  sequence="20"
                  action="vf_group_action"/>
    </data>
</odoo>
