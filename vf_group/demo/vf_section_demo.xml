<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Sections -->
        <record id="demo_section_sports" model="vf.section">
            <field name="name">Sports</field>
            <field name="code">SPORT</field>
            <field name="description">All sports activities and teams</field>
        </record>
        
        <record id="demo_section_youth" model="vf.section">
            <field name="name">Youth Activities</field>
            <field name="code">YOUTH</field>
            <field name="description">Activities for children and young people</field>
        </record>
        
        <record id="demo_section_admin" model="vf.section">
            <field name="name">Administration</field>
            <field name="code">ADMIN</field>
            <field name="description">Administrative committees and working groups</field>
        </record>
        
        <record id="demo_section_football" model="vf.section">
            <field name="name">Football</field>
            <field name="code">FOOT</field>
            <field name="description">Football teams and activities</field>
            <field name="parent_id" ref="demo_section_sports"/>
        </record>
        
        <record id="demo_section_swimming" model="vf.section">
            <field name="name">Swimming</field>
            <field name="code">SWIM</field>
            <field name="description">Swimming teams and activities</field>
            <field name="parent_id" ref="demo_section_sports"/>
        </record>
    </data>
</odoo>
