<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Group Types -->
        <record id="group_type_team" model="vf.group.type">
            <field name="name">Team</field>
            <field name="code">team</field>
            <field name="description">Sports team or activity team</field>
            <field name="sequence">10</field>
            <field name="default_max_members">30</field>
        </record>
        
        <record id="group_type_committee" model="vf.group.type">
            <field name="name">Committee</field>
            <field name="code">committee</field>
            <field name="description">Working committee or board committee</field>
            <field name="sequence">20</field>
            <field name="default_max_members">15</field>
            <field name="default_min_age">18</field>
        </record>
        
        <record id="group_type_working_group" model="vf.group.type">
            <field name="name">Working Group</field>
            <field name="code">working_group</field>
            <field name="description">Temporary or project-based working group</field>
            <field name="sequence">30</field>
            <field name="default_max_members">20</field>
        </record>
        
        <record id="group_type_training" model="vf.group.type">
            <field name="name">Training Group</field>
            <field name="code">training</field>
            <field name="description">Training or practice group</field>
            <field name="sequence">40</field>
            <field name="default_max_members">25</field>
        </record>
        
        <record id="group_type_other" model="vf.group.type">
            <field name="name">Other</field>
            <field name="code">other</field>
            <field name="description">Other type of group</field>
            <field name="sequence">90</field>
        </record>
    </data>
</odoo>
