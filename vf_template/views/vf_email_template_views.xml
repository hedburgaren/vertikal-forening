<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Email Template List View -->
        <record id="vf_email_template_view_tree" model="ir.ui.view">
            <field name="name">vf.email.template.tree</field>
            <field name="model">vf.email.template</field>
            <field name="arch" type="xml">
                <tree string="Email Templates">
                    <field name="display_name"/>
                    <field name="email_type"/>
                    <field name="category_id"/>
                    <field name="subject"/>
                    <field name="active"/>
                    <field name="usage_count" widget="integer"/>
                    <field name="last_used"/>
                </tree>
            </field>
        </record>

        <!-- Email Template Form View -->
        <record id="vf_email_template_view_form" model="ir.ui.view">
            <field name="name">vf.email.template.form</field>
            <field name="model">vf.email.template</field>
            <field name="arch" type="xml">
                <form string="Email Template">
                    <header>
                        <button name="action_send_test" type="object" 
                                string="Send Test Email" class="btn-primary"/>
                        <button name="action_preview" type="object" 
                                string="Preview" class="btn-secondary"/>
                        <button name="action_translate" type="object" 
                                string="Translate" class="btn-secondary"/>
                        <button name="action_duplicate" type="object" 
                                string="Duplicate" class="btn-secondary"/>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="category_id"/>
                                <field name="email_type"/>
                                <field name="usage_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="default_from"/>
                                <field name="reply_to"/>
                                <field name="last_used" readonly="1"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                        
                        <notebook>
                            <page string="Content">
                                <group>
                                    <field name="subject" placeholder="Email subject with variables like {{member_name}}"/>
                                </group>
                                <group>
                                    <field name="body_html" widget="html"/>
                                    <field name="body_text" 
                                           placeholder="Plain text version for email clients that don't support HTML"/>
                                </group>
                            </page>
                            
                            <page string="Attachments">
                                <field name="default_attachment_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="file_size"/>
                                        <field name="create_date"/>
                                    </tree>
                                </field>
                            </page>
                            
                            <page string="Variables">
                                <field name="variable_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="variable_type"/>
                                        <field name="description"/>
                                        <field name="required"/>
                                        <field name="example_value"/>
                                    </tree>
                                </field>
                            </page>
                            
                            <page string="Languages">
                                <group>
                                    <field name="available_languages" widget="many2many_tags"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Email Template Kanban View -->
        <record id="vf_email_template_view_kanban" model="ir.ui.view">
            <field name="name">vf.email.template.kanban</field>
            <field name="model">vf.email.template</field>
            <field name="arch" type="xml">
                <kanban string="Email Templates">
                    <field name="id"/>
                    <field name="display_name"/>
                    <field name="email_type"/>
                    <field name="category_id"/>
                    <field name="subject"/>
                    <field name="active"/>
                    <field name="usage_count"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.active.raw_value ? '' : 'oe_kanban_color_4'}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="display_name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="email_type"/> / <field name="category_id"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_manage_button_section">
                                        <a class="o_kanban_manage_toggle_button" href="#" tabindex="-1">
                                            <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="usage_count"/> uses
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <i class="fa fa-envelope" role="img"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Email Template Actions -->
        <record id="vf_email_template_action" model="ir.actions.act_window">
            <field name="name">Email Templates</field>
            <field name="res_model">vf.email.template</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first email template!
                </p>
                <p>
                    Email templates help you send consistent, professional emails to members.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="vf_email_template_menu" name="Email Templates" 
                  parent="vf_template_menu_main" 
                  action="vf_email_template_action" sequence="30"/>
    </data>
</odoo>
