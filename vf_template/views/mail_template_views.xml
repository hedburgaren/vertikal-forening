<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Mail Template Form to add VF features -->
        <record id="mail_template_view_form_inherit_vf" model="ir.ui.view">
            <field name="name">mail.template.form.inherit.vf</field>
            <field name="model">mail.template</field>
            <field name="inherit_id" ref="mail.email_template_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='model_id']" position="after">
                    <group string="Vertical Association" name="vf_settings">
                        <field name="is_association_template"/>
                        <field name="vf_template_id" 
                               attrs="{'invisible': [('is_association_template', '=', False)]}"/>
                        <field name="vf_layout_id" 
                               domain="[('layout_type', '=', 'email')]"
                               attrs="{'invisible': [('is_association_template', '=', False)]}"/>
                        <field name="association_variables" 
                               attrs="{'invisible': [('is_association_template', '=', False)]}"
                               placeholder='{"member_name": "John Doe", "membership_number": "VF000001"}'/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
