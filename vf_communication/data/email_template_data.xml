<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email Templates -->
        <record id="email_template_contact_confirmation" model="mail.template">
            <field name="name">Contact Form - Confirmation</field>
            <field name="model_id" ref="model_vf_contact_form"/>
            <field name="subject">We received your message: ${object.subject}</field>
            <field name="email_from">${object.mailbox_id.email or 'noreply@association.local'}</field>
            <field name="email_to">${object.sender_email}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear ${object.sender_name},</p>
    <p>Thank you for contacting us. We have received your message with subject "<strong>${object.subject}</strong>" and will get back to you as soon as possible.</p>
    <p>Your message was sent to: ${object.mailbox_id.display_name}</p>
    <p>Best regards,<br/>${object.company_id.name}</p>
</div>
            </field>
        </record>
        
        <record id="email_template_mandate_expiry" model="mail.template">
            <field name="name">Mandate - Expiry Reminder</field>
            <field name="model_id" ref="vf_role.model_vf_mandate"/>
            <field name="subject">Mandate Expiring Soon: ${object.position_id.name}</field>
            <field name="email_from">${object.company_id.email}</field>
            <field name="email_to">${object.person_id.email}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear ${object.person_id.name},</p>
    <p>This is a reminder that your mandate for <strong>${object.position_id.name}</strong> will expire on ${object.end_date}.</p>
    <p>Please contact the association administration to discuss renewal or extension of your mandate.</p>
    <p>Thank you for your service to the association.</p>
    <p>Best regards,<br/>${object.company_id.name}</p>
</div>
            </field>
        </record>
        
        <record id="email_template_new_member_welcome" model="mail.template">
            <field name="name">Member - Welcome</field>
            <field name="model_id" ref="vf_member.model_vf_member"/>
            <field name="subject">Welcome to ${object.company_id.name}!</field>
            <field name="email_from">${object.company_id.email}</field>
            <field name="email_to">${object.partner_id.email}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear ${object.partner_id.name},</p>
    <p>Welcome to ${object.company_id.name}! We're excited to have you as a member.</p>
    <p>Your membership number is: <strong>${object.membership_number}</strong></p>
    <p>Membership date: ${object.membership_date}</p>
    <p>If you have any questions, please don't hesitate to contact us.</p>
    <p>Best regards,<br/>${object.company_id.name}</p>
</div>
            </field>
        </record>
    </data>
</odoo>
