<p>Don't forget your swimsuits and towels!</p>
<p>Best regards,<br/>Coach Sofia</p>
            ]]></field>
            <field name="sender_id" ref="vf_member.demo_partner_adult3"/>
            <field name="date">2024-02-20 09:00:00</field>
            <field name="state">sent</field>
