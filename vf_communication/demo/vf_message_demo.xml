        <!-- Demo Messages -->
        <!-- Organization Messages -->
        <record id="demo_message_welcome" model="vf.message">
            <field name="subject">Welcome to the Association!</field>
            <field name="body"><![CDATA[
<p>Dear Members,</p>
<p>Welcome to our association! We're excited to have you join our community.</p>
<p>Please take a moment to familiarize yourself with our activities and groups.</p>
<p>Best regards,<br/>The Board</p>
            ]]></field>
            <field name="sender_id" ref="vf_member.demo_partner_adult1"/>
            <field name="date">2024-01-15 09:00:00</field>
            <field name="state">sent</field>
            <field name="send_email">True</field>
            <field name="priority">high</field>
        </record>
        
        <record id="demo_message_agm" model="vf.message">
            <field name="subject">Annual General Meeting - Save the Date</field>
            <field name="body"><![CDATA[
<p>Dear Members,</p>
<p>This year's Annual General Meeting will be held on March 15, 2024 at 18:00.</p>
<p>Agenda will be sent out closer to the date.</p>
<p>Your attendance is important!</p>
<p>Best regards,<br/>The Secretary</p>
            ]]></field>
            <field name="sender_id" ref="vf_member.demo_partner_adult3"/>
            <field name="date">2024-01-20 10:00:00</field>
            <field name="state">sent</field>
            <field name="send_email">True</field>
            <field name="priority">high</field>
        </record>
        
        <!-- Section Messages -->
        <record id="demo_message_sports_update" model="vf.message">
            <field name="subject">Sports Section - Spring Season Starting Soon</field>
            <field name="body"><![CDATA[
<p>Dear Sports Members,</p>
<p>The spring season is starting on March 1st. Please ensure your memberships are up to date.</p>
<p>Training schedules will be posted next week.</p>
<p>Best regards,<br/>Sports Manager</p>
            ]]></field>
            <field name="sender_id" ref="vf_member.demo_partner_adult2"/>
            <field name="date">2024-02-01 14:00:00</field>
            <field name="state">sent</field>
            <field name="send_email">True</field>
            <field name="priority">normal</field>
        </record>
        
        <record id="demo_message_youth_activities" model="vf.message">
            <field name="subject">Youth Activities - Spring Program</field>
            <field name="body"><![CDATA[
<p>Dear Parents and Youth Members,</p>
<p>Our spring program is now available! Check out our exciting activities:</p>
<ul>
<li>Youth Club - Every Tuesday 17:00-19:00</li>
<li>Swimming Training - Monday & Wednesday 16:00-17:30</li>
<li>Football Practice - Thursday 17:00-18:30</li>
</ul>
<p>Sign up at the office or online.</p>
<p>Best regards,<br/>Youth Activities Manager</p>
            ]]></field>
            <field name="sender_id" ref="vf_member.demo_partner_adult1"/>
            <field name="date">2024-02-10 11:00:00</field>
            <field name="state">sent</field>
            <field name="send_email">True</field>
            <field name="priority">normal</field>
        </record>
        
        <!-- Group Messages -->
        <record id="demo_message_football_u12" model="vf.message">
            <field name="subject">Football U12 - First Practice</field>
            <field name="body"><![CDATA[
<p>Dear Players and Parents,</p>
<p>Our first practice of the season will be on March 1st at 16:00.</p>
<p>Please remember to bring:</p>
<ul>
<li>Football boots</li>
<li>Shin guards</li>
<li>Water bottle</li>
<li>Sports clothes</li>
</ul>
<p>Looking forward to seeing everyone there!</p>
<p>Best regards,<br/>Coach Erik</p>
            ]]></field>
            <field name="sender_id" ref="vf_member.demo_partner_adult2"/>
            <field name="date">2024-02-15 16:30:00</field>
            <field name="state">sent</field>
            <field name="send_email">True</field>
            <field name="priority">normal</field>
        </record>
        
