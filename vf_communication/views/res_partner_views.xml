<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Partner Form View Extension -->
        <record id="view_res_partner_form_inherit_vf_communication" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.vf.communication</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_id']" position="after">
                    <group name="vf_communication_info" string="Communication" 
                           attrs="{'invisible': [('is_company', '=', True)]}">
                        <field name="message_count" readonly="1"/>
                        <field name="unread_message_count" readonly="1"/>
                        <button name="action_compose_message" type="object" string="Compose Message" 
                                class="btn-link"/>
                        <button name="action_view_messages" type="object" string="View Messages" 
                                class="btn-link"/>
                        <button name="action_view_mailboxes" type="object" string="View Mailboxes" 
                                class="btn-link"/>
                    </group>
                </xpath>
                
                <xpath expr="//notebook" position="inside">
                    <page string="Communication" attrs="{'invisible': [('is_company', '=', True)]}">
                        <group string="Messages">
                            <field name="sent_message_ids">
                                <tree>
                                    <field name="subject"/>
                                    <field name="date"/>
                                    <field name="state"/>
                                    <field name="recipient_count"/>
                                </tree>
                            </field>
                        </group>
                        
                        <group string="Mailboxes">
                            <field name="mailbox_ids">
                                <tree>
                                    <field name="display_name"/>
                                    <field name="email"/>
                                    <field name="current_holders"/>
                                </tree>
                            </field>
                        </group>
                        
                        <group string="Contact Forms">
                            <field name="contact_form_ids">
                                <tree>
                                    <field name="subject"/>
                                    <field name="date"/>
                                    <field name="state"/>
                                    <field name="mailbox_id"/>
                                </tree>
                            </field>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
