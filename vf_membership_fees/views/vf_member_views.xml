<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Member Form View Extension -->
        <record id="view_vf_member_form_inherit_vf_membership_fees" model="ir.ui.view">
            <field name="name">vf.member.form.inherit.vf.membership.fees</field>
            <field name="model">vf.member</field>
            <field name="inherit_id" ref="vf_member.view_vf_member_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='membership_date']" position="after">
                    <group name="vf_fee_info" string="Membership Fees">
                        <field name="fee_category_id"/>
                        <field name="payment_method"/>
                        <field name="total_fees" readonly="1"/>
                        <field name="total_paid" readonly="1"/>
                        <field name="total_outstanding" readonly="1"/>
                        <field name="has_overdue_fees" readonly="1"/>
                        <button name="action_view_fees" type="object" string="View Fees" 
                                class="btn-link"/>
                        <button name="action_make_payment" type="object" string="Make Payment" 
                                class="btn-link"/>
                        <button name="action_request_waiver" type="object" string="Request Waiver" 
                                class="btn-link"/>
                    </group>
                </xpath>
                
                <xpath expr="//notebook" position="inside">
                    <page string="Fees & Payments">
                        <group string="Fee Summary">
                            <field name="total_fees" readonly="1"/>
                            <field name="total_paid" readonly="1"/>
                            <field name="total_outstanding" readonly="1"/>
                            <field name="overdue_fees" readonly="1"/>
                        </group>
                        
                        <group string="Fees">
                            <field name="fee_ids">
                                <tree decoration-danger="is_overdue">
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="amount"/>
                                    <field name="paid_amount"/>
                                    <field name="remaining_amount"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                    <field name="is_overdue" invisible="1"/>
                                </tree>
                            </field>
                        </group>
                        
                        <group string="Waivers">
                            <field name="waiver_ids">
                                <tree>
                                    <field name="fee_id"/>
                                    <field name="waiver_type"/>
                                    <field name="amount"/>
                                    <field name="request_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
