<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Fee Due Email Template -->
        <record id="email_template_fee_due" model="mail.template">
            <field name="name">Membership Fee Due</field>
            <field name="model_id" ref="model_vf_fee"/>
            <field name="subject">Membership Fee Due - ${object.name}</field>
            <field name="email_from">${object.member_id.partner_id.email_formatted | safe}</field>
            <field name="email_to">${object.member_id.partner_id.email | safe}</field>
            <field name="lang">${object.member_id.partner_id.lang}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear ${object.member_id.partner_id.name},</p>
                    <p>This is a reminder that your membership fee is due:</p>
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Fee Type:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">${object.category_id.name}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Amount:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">${object.amount} ${object.currency_id.symbol}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Due Date:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">${object.due_date}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Period:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">${object.period_start} to ${object.period_end}</td>
                        </tr>
                    </table>
                    <p style="margin-top: 20px;">Please ensure payment is made by the due date to avoid any interruption in your membership benefits.</p>
                    <p>If you have any questions or need to arrange a payment plan, please contact us.</p>
                    <p>Thank you for your continued support!</p>
                    <p>Best regards,<br/>${user.company_id.name}</p>
                </div>
            </field>
        </record>
        
        <!-- Fee Reminder Email Template -->
        <record id="email_template_fee_reminder" model="mail.template">
            <field name="name">Membership Fee Reminder</field>
            <field name="model_id" ref="model_vf_fee"/>
            <field name="subject">URGENT: Membership Fee Overdue - ${object.name}</field>
            <field name="email_from">${object.member_id.partner_id.email_formatted | safe}</field>
            <field name="email_to">${object.member_id.partner_id.email | safe}</field>
            <field name="lang">${object.member_id.partner_id.lang}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear ${object.member_id.partner_id.name},</p>
                    <p style="color: #d32f2f;"><strong>URGENT REMINDER:</strong> Your membership fee is overdue!</p>
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Fee Type:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">${object.category_id.name}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Amount Due:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd; color: #d32f2f;">${object.remaining_amount} ${object.currency_id.symbol}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Due Date:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd; color: #d32f2f;">${object.due_date} (${object.days_overdue} days overdue)</td>
                        </tr>
                    </table>
                    <p style="margin-top: 20px;">Please make your payment as soon as possible to avoid suspension of your membership.</p>
                    <p>If you're experiencing financial difficulties, please contact us to discuss payment options or fee waivers.</p>
                    <p>Payment methods accepted:</p>
                    <ul>
                        <li>Bank transfer</li>
                        <li>Cash at the office</li>
                        <li>Online payment</li>
                    </ul>
                    <p>Thank you for your prompt attention to this matter.</p>
                    <p>Best regards,<br/>${user.company_id.name}</p>
                </div>
            </field>
        </record>
        
        <!-- Waiver Request Email Template -->
        <record id="email_template_waiver_request" model="mail.template">
            <field name="name">Fee Waiver Request</field>
            <field name="model_id" ref="model_vf_fee_waiver"/>
            <field name="subject">Fee Waiver Request - ${object.fee_id.member_id.name}</field>
            <field name="email_from">${object.fee_id.member_id.partner_id.email_formatted | safe}</field>
            <field name="email_to">${user.email | safe}</field>
            <field name="lang">${object.fee_id.member_id.partner_id.lang}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>A fee waiver request has been submitted:</p>
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Member:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">${object.fee_id.member_id.name}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Fee:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">${object.fee_id.category_id.name} - ${object.fee_id.amount} ${object.fee_id.currency_id.symbol}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Waiver Type:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">${object.waiver_type}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Amount:</strong></td>
                            <td style="padding: 8px; border: 1px solid #td;">${object.amount} ${object.fee_id.currency_id.symbol}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Request Date:</strong></td>
                            <td style="padding: 8px; border: 1px solid #td;">${object.request_date}</td>
                        </tr>
                    </table>
                    <p><strong>Reason:</strong></p>
                    <p>${object.reason}</p>
                    <p>Please review and approve or reject this request.</p>
                    <p>Best regards,<br/>${user.company_id.name}</p>
                </div>
            </field>
        </record>
        
        <!-- Waiver Approved Email Template -->
        <record id="email_template_waiver_approved" model="mail.template">
            <field name="name">Fee Waiver Approved</field>
            <field name="model_id" ref="model_vf_fee_waiver"/>
            <field name="subject">Fee Waiver Approved - ${object.fee_id.name}</field>
            <field name="email_from">${user.email | safe}</field>
            <field name="email_to">${object.fee_id.member_id.partner_id.email | safe}</field>
            <field name="lang">${object.fee_id.member_id.partner_id.lang}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear ${object.fee_id.member_id.partner_id.name},</p>
                    <p style="color: #388e3c;"><strong>Good news!</strong> Your fee waiver request has been approved.</p>
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Fee:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">${object.fee_id.category_id.name}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Waiver Amount:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd; color: #388e3c;">${object.amount} ${object.fee_id.currency_id.symbol}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Approval Date:</strong></td>
                            <td style="padding: 8px; border: 1px solid #td;">${object.decision_date}</td>
                        </tr>
                    </table>
                    <p style="margin-top: 20px;">Your fee has been waived according to the approved amount.</p>
                    <p>If you have any questions, please don't hesitate to contact us.</p>
                    <p>Best regards,<br/>${user.company_id.name}</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
