<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sponsor Tree View -->
        <record id="vf_sponsor_view_tree" model="ir.ui.view">
            <field name="name">vf.sponsor.tree</field>
            <field name="model">vf.sponsor</field>
            <field name="arch" type="xml">
                <tree string="Sponsors">
                    <field name="display_name"/>
                    <field name="sponsorship_level_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="annual_amount"/>
                    <field name="state"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>
        
        <!-- Sponsor Form View -->
        <record id="vf_sponsor_view_form" model="ir.ui.view">
            <field name="name">vf.sponsor.form</field>
            <field name="model">vf.sponsor</field>
            <field name="arch" type="xml">
                <form string="Sponsor">
                    <header>
                        <button name="action_activate" type="object" string="Activate" 
                                attrs="{'invisible': [('state', '!=', 'prospect')]}" class="btn-primary"/>
                        <button name="action_renew" type="object" string="Renew" 
                                attrs="{'invisible': [('state', '!=', 'active')]}" class="btn-secondary"/>
                        <button name="action_terminate" type="object" string="Terminate" 
                                attrs="{'invisible': [('state', '=', 'terminated')]}" class="btn-warning"/>
                        <button name="action_send_update" type="object" string="Send Update" 
                                attrs="{'invisible': [('state', '!=', 'active')]}" class="btn-info"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_contracts" type="object" 
                                    class="oe_stat_button" icon="fa-file-contract">
                                <field name="contract_ids" widget="statinfo" 
                                       string="Contracts" help="Number of contracts"/>
                            </button>
                        </div>
                        
                        <group>
                            <group name="sponsor_info">
                                <field name="partner_id" required="1"/>
                                <field name="sponsorship_level_id" required="1"/>
                                <field name="start_date" required="1"/>
                                <field name="end_date" required="1"/>
                            </group>
                            <group name="financial_info">
                                <field name="annual_amount" required="1"/>
                                <field name="currency_id"/>
                                <field name="total_invoiced" readonly="1"/>
                                <field name="total_paid" readonly="1"/>
                                <field name="outstanding_amount" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Contact">
                                <group>
                                    <field name="contact_person_id"/>
                                    <field name="communication_frequency"/>
                                    <field name="website_url"/>
                                </group>
                            </page>
                            
                            <page string="Benefits">
                                <field name="benefit_ids" widget="many2many_tags"/>
                            </page>
                            
                            <page string="Description">
                                <field name="description" widget="html"/>
                            </page>
                            
                            <page string="Contracts">
                                <field name="contract_ids">
                                    <tree>
                                        <field name="contract_number"/>
                                        <field name="type"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="amount"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Sponsor Search View -->
        <record id="vf_sponsor_view_search" model="ir.ui.view">
            <field name="name">vf.sponsor.search</field>
            <field name="model">vf.sponsor</field>
            <field name="arch" type="xml">
                <search string="Sponsors">
                    <field name="partner_id"/>
                    <field name="sponsorship_level_id"/>
                    <field name="state"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Prospect" name="prospect" domain="[('state', '=', 'prospect')]"/>
                    <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Sponsorship Level" name="group_level" context="{'group_by': 'sponsorship_level_id'}"/>
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Sponsor Action -->
        <record id="vf_sponsor_action" model="ir.actions.act_window">
            <field name="name">Sponsors</field>
            <field name="res_model">vf.sponsor</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first sponsor
                </p>
                <p>
                    Manage sponsor relationships and track sponsorship levels and benefits.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_sponsorship_menu_root" name="Sponsorship" parent="vf_base.vf_association_menu" sequence="70"/>
        <menuitem id="vf_sponsor_menu" name="Sponsors" parent="vf_sponsorship_menu_root" sequence="10"/>
        <menuitem id="vf_sponsor_menu_list" name="All Sponsors" parent="vf_sponsor_menu" 
                  action="vf_sponsor_action" sequence="10"/>
    </data>
</odoo>
