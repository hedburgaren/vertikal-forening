<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Partner Form View Extension -->
        <record id="res_partner_view_form_sponsorship" model="ir.ui.view">
            <field name="name">res.partner.form.sponsorship</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_sponsorships" type="object" 
                            class="oe_stat_button" icon="fa-handshake-o"
                            attrs="{'invisible': [('is_sponsor', '=', False)]}">
                        <field name="sponsorship_level" widget="statinfo" 
                               string="Sponsorship" help="Current sponsorship level"/>
                    </button>
                    <button name="action_view_merchandise_orders" type="object" 
                            class="oe_stat_button" icon="fa-shopping-cart"
                            attrs="{'invisible': [('merchandise_order_count', '=', 0)]}">
                        <field name="merchandise_order_count" widget="statinfo" 
                               string="Orders" help="Number of merchandise orders"/>
                    </button>
                </xpath>
                
                <xpath expr="//notebook" position="inside">
                    <page string="Sponsorship" attrs="{'invisible': [('is_sponsor', '=', False)]}">
                        <group>
                            <field name="is_sponsor"/>
                            <field name="sponsorship_level"/>
                            <field name="current_sponsorship_id"/>
                            <field name="has_active_contract"/>
                        </group>
                        
                        <group string="Quick Actions">
                            <button name="action_create_sponsorship" type="object" string="Create Sponsorship" 
                                    class="btn-primary" attrs="{'invisible': [('is_sponsor', '=', True)]}"/>
                            <button name="action_create_merchandise_order" type="object" string="Create Merchandise Order" 
                                    class="btn-secondary"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
