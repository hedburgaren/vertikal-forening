<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Merchandise Order Tree View -->
        <record id="vf_merchandise_order_view_tree" model="ir.ui.view">
            <field name="name">vf.merchandise.order.tree</field>
            <field name="model">vf.merchandise.order</field>
            <field name="arch" type="xml">
                <tree string="Merchandise Orders">
                    <field name="order_number"/>
                    <field name="partner_id"/>
                    <field name="date_ordered"/>
                    <field name="total_amount"/>
                    <field name="state"/>
                    <field name="payment_status"/>
                </tree>
            </field>
        </record>
        
        <!-- Merchandise Order Form View -->
        <record id="vf_merchandise_order_view_form" model="ir.ui.view">
            <field name="name">vf.merchandise.order.form</field>
            <field name="model">vf.merchandise.order</field>
            <field name="arch" type="xml">
                <form string="Merchandise Order">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm Order" 
                                attrs="{'invisible': [('state', '!=', 'draft')]}" class="btn-primary"/>
                        <button name="action_cancel" type="object" string="Cancel" 
                                attrs="{'invisible': [('state', '=', 'cancelled')]}" class="btn-warning"/>
                        <button name="action_mark_shipped" type="object" string="Mark Shipped" 
                                attrs="{'invisible': [('state', '!=', 'paid')]}" class="btn-info"/>
                        <button name="action_mark_delivered" type="object" string="Mark Delivered" 
                                attrs="{'invisible': [('state', '!=', 'shipped')]}" class="btn-success"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group name="order_info">
                                <field name="order_number" readonly="1"/>
                                <field name="partner_id" required="1"/>
                                <field name="member_id"/>
                                <field name="date_ordered" required="1"/>
                            </group>
                            <group name="shipping_info">
                                <field name="shipping_address_id"/>
                                <field name="tracking_number"/>
                                <field name="shipping_date" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Order Lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id" required="1"/>
                                        <field name="quantity" required="1"/>
                                        <field name="unit_price" required="1"/>
                                        <field name="price_total" readonly="1"/>
                                    </tree>
                                </field>
                            </page>
                            
                            <page string="Sales Order">
                                <group>
                                    <field name="sale_order_id" readonly="1"/>
                                </group>
                            </page>
                            
                            <page string="Notes">
                                <group>
                                    <field name="order_notes"/>
                                    <field name="internal_notes" groups="vf_sponsorship.group_sponsorship_admin"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Merchandise Order Search View -->
        <record id="vf_merchandise_order_view_search" model="ir.ui.view">
            <field name="name">vf.merchandise.order.search</field>
            <field name="model">vf.merchandise.order</field>
            <field name="arch" type="xml">
                <search string="Merchandise Orders">
                    <field name="order_number"/>
                    <field name="partner_id"/>
                    <field name="state"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                    <filter string="Shipped" name="shipped" domain="[('state', '=', 'shipped')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Payment Status" name="group_payment" context="{'group_by': 'payment_status'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Merchandise Order Action -->
        <record id="vf_merchandise_order_action" model="ir.actions.act_window">
            <field name="name">Merchandise Orders</field>
            <field name="res_model">vf.merchandise.order</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first merchandise order
                </p>
                <p>
                    Manage merchandise orders with sales integration.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="vf_merchandise_order_menu" name="Orders" parent="vf_merchandise_menu" 
                  action="vf_merchandise_order_action" sequence="20"/>
    </data>
</odoo>
