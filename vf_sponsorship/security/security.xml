<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Security Groups -->
        <record id="group_sponsorship_user" model="res.groups">
            <field name="name">Sponsorship User</field>
            <field name="category_id" ref="vf_base.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="group_sponsorship_manager" model="res.groups">
            <field name="name">Sponsorship Manager</field>
            <field name="category_id" ref="vf_base.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('group_sponsorship_user'))]"/>
        </record>
        
        <record id="group_sponsorship_admin" model="res.groups">
            <field name="name">Sponsorship Admin</field>
            <field name="category_id" ref="vf_base.module_category_vertical_association"/>
            <field name="implied_ids" eval="[(4, ref('group_sponsorship_manager'))]"/>
        </record>
        
        <!-- Record Rules -->
        <record id="rule_sponsor_user" model="ir.rule">
            <field name="name">Sponsor: User Read</field>
            <field name="model_id" ref="model_vf_sponsor"/>
            <field name="domain_force">[('state', '!=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('group_sponsorship_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="rule_contract_user" model="ir.rule">
            <field name="name">Sponsorship Contract: User Read</field>
            <field name="model_id" ref="model_vf_sponsorship_contract"/>
            <field name="domain_force">[('state', 'in', ['sent', 'signed', 'active'])]</field>
            <field name="groups" eval="[(4, ref('group_sponsorship_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="rule_merchandise_user" model="ir.rule">
            <field name="name">Merchandise: User Read Active</field>
            <field name="model_id" ref="model_vf_merchandise_product"/>
            <field name="domain_force">[('state', 'in', ['available', 'sold_out'])]</field>
            <field name="groups" eval="[(4, ref('group_sponsorship_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
